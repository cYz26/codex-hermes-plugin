{
  "description": "Project-scoped Hermes learning evidence and feedback. No model calls in hooks.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 5, "additionalContextLimit": 256}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 5, "additionalContextLimit": 256}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 5}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 5, "additionalContextLimit": 256}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 5}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 2}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/bridge\" hook", "timeout": 3}]}]
  }
}
