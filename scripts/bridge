#!/usr/bin/env python3
"""Use the plugin's pure-stdlib client even before a Hermes runtime is provisioned."""
import json
import os
import sys
from pathlib import Path

settings = Path(os.environ.get("HERMES_LEARNING_CONFIG", Path.home() / ".hermes-codex-learning/pilot/bridge.json"))
if settings.exists():
    interpreter = json.loads(settings.read_text())["python"]
    # Preserve the venv symlink: resolving it would select the bare base interpreter.
    if os.path.abspath(sys.executable) != os.path.abspath(interpreter):
        os.execv(interpreter, [interpreter, __file__, *sys.argv[1:]])
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
from hermes_codex_learning.cli import main

raise SystemExit(main())
