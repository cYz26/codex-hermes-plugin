@@ -0,0 +1,10 @@
+"""Tool-item nudge policy shared by native Codex execution and observed execution."""
+
+
+def tick_skill_review(agent, completed_items: int) -> bool:
+    agent._iters_since_skill = getattr(agent, "_iters_since_skill", 0) + completed_items
+    due = (0 < agent._skill_nudge_interval <= agent._iters_since_skill
+           and "skill_manage" in agent.valid_tool_names)
+    if due:
+        agent._iters_since_skill = 0
+    return due
diff --git a/agent/learning_results.py b/agent/learning_results.py
new file mode 100644
index 0000000..789f385
--- /dev/null
+++ b/agent/learning_results.py
@@ -0,0 +1,70 @@
+"""Machine-readable facts from native review tool results, independent of UI summaries."""
+from __future__ import annotations
+
+import json
+
+
+def changed_skill_name(fact: dict) -> str | None:
+    """Read both canonical facts and v1 receipts written before batch names were lifted."""
+    return fact.get("name") or fact.get("operation", {}).get("name")
+
+
+def _skill_batch_fact(fact: dict, operation: dict) -> dict:
+    return {**fact, "operation": operation,
+            "name": operation.get("name") or fact.get("name"),
+            "action": operation.get("action") or fact.get("action")}
+
+
+def review_outcome(state, error: str | None = None, *, prior_snapshot: list | None = None) -> dict:
+    prior_ids = {call["id"] for msg in prior_snapshot or [] for call in msg.get("tool_calls", []) or [] if call.get("id")}
+    calls = {}
+    for msg in state.review_messages:
+        for call in msg.get("tool_calls", []) or []:
+            fn = call.get("function", {})
+            if fn.get("name") in {"memory", "skill_manage"} and call.get("id") not in prior_ids:
+                try:
+                    calls[call["id"]] = (fn["name"], json.loads(fn.get("arguments", "{}")))
+                except (ValueError, KeyError):
+                    continue
+    outcome = {"applied": [], "staged": [], "refused": [], "uncertain": [],
+               "usage": state.review_usage or None, "error": error}
+    for msg in state.review_messages:
+        if msg.get("role") != "tool" or msg.get("tool_call_id") not in calls:
+            continue
+        tool, args = calls[msg["tool_call_id"]]
+        try:
+            data = json.loads(msg.get("content", "{}"))
+        except (ValueError, TypeError):
+            outcome["uncertain"].append({"tool": tool, "call_id": msg["tool_call_id"]})
+            continue
+        if not isinstance(data, dict):
+            outcome["uncertain"].append({"tool": tool, "call_id": msg["tool_call_id"]})
+            continue
+        fact = {"tool": tool, "action": args.get("action"), "name": args.get("name"),
+                "target": args.get("target"), "call_id": msg["tool_call_id"], "result": data}
+        if data.get("staged"):
+            outcome["staged"].append(fact)
+        elif data.get("success") is not True:
+            outcome["refused"].append(fact)
+        elif tool == "skill_manage" and "results" in data:
+            if data.get("operations_applied"):
+                outcome["applied"].extend(_skill_batch_fact(fact, item) for item in data["results"]
+                                          if isinstance(item, dict) and item.get("success") is True)
+        else:
+            outcome["applied"].append(fact)
+    result = state.result or {}
+    reason = result.get("turn_exit_reason")
+    if isinstance(reason, str) and len(reason) <= 200:
+        outcome["turn_exit_reason"] = reason
+    if error or result.get("failed") or result.get("error"):
+        outcome["run_status"] = "failed"
+        outcome["error"] = error or result.get("error")
+    elif result.get("interrupted"):
+        outcome["run_status"] = "interrupted"
+    elif result.get("completed") is True:
+        outcome["run_status"] = "completed"
+    else:
+        outcome["run_status"] = "unknown"
+    outcome["no_change"] = (outcome["run_status"] == "completed" and
+                            not any(outcome[k] for k in ("applied", "staged", "uncertain")))
+    return outcome
diff --git a/agent/learning_runtime.py b/agent/learning_runtime.py
