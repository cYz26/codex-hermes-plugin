+"""External observation admission, recovery and actual native result semantics."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from agent.learning_results import review_outcome
+from agent.learning_policy import tick_skill_review
+from agent.turn_context import _tick_memory_nudge
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+class Runtime:
+    def __init__(self):
+        self.projects = []
+        self.reviews = 0
+
+    def tick(self, handle, source, memory_count, skill_count, *, new_turn, tools):
+        agent = SimpleNamespace(_memory_nudge_interval=2, _turns_since_memory=memory_count,
+                                _memory_store=True, valid_tool_names={"memory", "skill_manage"},
+                                _skill_nudge_interval=2, _iters_since_skill=skill_count)
+        memory = _tick_memory_nudge(agent) if new_turn else False
+        skills = tick_skill_review(agent, tools)
+        return dict(memory=memory, skills=skills, memory_count=agent._turns_since_memory, skill_count=agent._iters_since_skill)
+
+    def project(self, handle, source, messages, **kwargs):
+        self.projects.extend(messages)
+        return "not_configured"
+
+    def review(self, *args):
+        self.reviews += 1
+        return {"run_status": "completed", "applied": [], "staged": [], "uncertain": [], "usage": None}
+
+    def maintenance(self, idle_seconds):
+        return {"curator": None}
+
+    def cancel(self):
+        return None
+
+    def usage(self, handles):
+        return None
+
+    def close(self):
+        return {}
+
+
+@pytest.fixture
+def service(tmp_path, monkeypatch):
+    from agent import learning_runtime
+    from agent.learning_service import LearningService
+    monkeypatch.setattr(learning_runtime, "NativeLearningRuntime", Runtime)
+    api = LearningService(tmp_path, "fixture")
+    yield api
+    api.close()
+
+
+def source():
+    return {"host": "fixture", "project": "/tmp/project", "chat": "actual-chat"}
+
+
+def body(turn="turn-1", calls=()):
+    return {"source": {**source(), "turn": turn}, "user": "Use the verified input", "assistant": "Verified output",
+            "status": "completed", "tools": [{"call_id": c, "name": "terminal", "arguments": {"command": "check"},
+                                               "result": "passed", "status": "completed"} for c in calls]}
+
+
+def test_admission_and_native_ticks_are_idempotent(service):
+    handle = service.open(source())["handle"]
+    first = service.observe(handle, body(calls=("one",)), event_id="capture-1")
+    assert first["new_user_turn"] and first["completed_tool_delta"] == 1
+    assert service.observe(handle, body(calls=("one",)), event_id="capture-1") == first
+    duplicate = service.observe(handle, body(calls=("one",)), event_id="new-capture-same-source")
+    assert duplicate["duplicate_of"] == "capture-1"
+    second = service.observe(handle, body("turn-2", ("two",)), event_id="capture-2")
+    assert second["intent"]
+    intent = service.read(kind="status")["intents"][0]
+    assert intent["memory"] and intent["skills"]
+    result = service.run_review(handle, intent["id"], attempt_id="attempt-1")
+    assert result["run_status"] == "completed"
+    service.run_review(handle, intent["id"], attempt_id="attempt-1")
+    assert service.runtime.reviews == 1
+
+
+def test_same_identity_different_payload_and_wrong_scope_are_rejected(service):
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="capture")
+    with pytest.raises(ValueError, match="conflict"):
+        service.observe(handle, {**body(), "assistant": "different"}, event_id="capture")
+    other = body()
+    other["source"]["chat"] = "different-chat"
+    with pytest.raises(ValueError, match="scope mismatch"):
+        service.observe(handle, other, event_id="different")
+
+
+def test_idle_supplement_has_explicit_reason_and_does_not_repeat_reviewed_input(service):
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="capture")
+    intent_id = service.maintenance(handle=handle, idle_flush=True)["intent"]
+    intent = service.read(kind="status")["intents"][0]
+    assert intent["reason"] == "idle_flush"
+    service.run_review(handle, intent_id, attempt_id="attempt")
+    assert service.maintenance(handle=handle, idle_flush=True)["intent"] is None
+
+
+def test_explicit_requests_can_relearn_a_snapshot_without_reobserving(service):
+    handle = service.open(source())["handle"]
+    snapshot = [{"role": "user", "content": "Verified source material"}]
+    first = service.request_review(handle, request_id="manual-1", messages=snapshot,
+                                   focus="Only the retry rule", memory=False, skills=True)
+    assert service.request_review(handle, request_id="manual-1", messages=snapshot,
+                                  focus="Only the retry rule", memory=False, skills=True) == first
+    with pytest.raises(ValueError, match="conflict"):
+        service.request_review(handle, request_id="manual-1", messages=snapshot, focus="Changed")
+    result = service.run_review(handle, first["id"], attempt_id="manual-attempt-1")
+    assert result["run_status"] == "completed"
+    second = service.request_review(handle, request_id="manual-2", messages=snapshot, focus="Now the validation")
+    service.run_review(handle, second["id"], attempt_id="manual-attempt-2")
+    assert service.runtime.reviews == 2
+    assert service.db.execute("SELECT COUNT(*) FROM observations").fetchone()[0] == 0
+    assert service.read(kind="request", name="manual-1")["attempt"]["run_status"] == "completed"
+
+
+def test_cancelled_explicit_request_cannot_start(service):
+    handle = service.open(source())["handle"]
+    intent = service.request_review(handle, request_id="cancel-1", messages=[{"role":"user","content":"fixture"}])
+    assert service.cancel_request("cancel-1")["status"] == "cancelled"
+    with pytest.raises(ValueError, match="not queued"):
+        service.run_review(handle, intent["id"], attempt_id="should-not-run")
+    assert service.runtime.reviews == 0
+
+
+def test_uncertain_review_cannot_be_replayed_by_changing_the_request_id(service):
+    handle = service.open(source())["handle"]
+    messages = [{"role":"user","content":"fixture"}]
+    intent = service.request_review(handle, request_id="uncertain", messages=messages)
+    with service.db:
+        service.db.execute("UPDATE intents SET status='unknown' WHERE id=?", (intent["id"],))
+    with pytest.raises(ValueError, match="uncertain review"):
+        service.request_review(handle, request_id="another-id", messages=messages)
+    assert service.request_review(handle, request_id="uncertain", messages=messages) == intent
+
+
+def test_explicit_retention_keeps_idempotency_without_retaining_source_body(service):
+    import time
+    handle = service.open(source())["handle"]
+    messages = [{"role":"user","content":"BODY-TO-RETIRE"}]
+    intent = service.request_review(handle, request_id="retire-me", messages=messages, focus="PRIVATE-FOCUS")
+    service.run_review(handle, intent["id"], attempt_id="retired-attempt")
+    with service.db:
+        service.db.execute("UPDATE explicit_reviews SET created=?", (time.time()-40*86400,))
+    assert service.prune(dry_run=False)["eligible_explicit_requests"] == 1
+    assert service.db.execute("SELECT messages FROM explicit_reviews").fetchone()[0] == "[]"
+    replay = service.request_review(handle, request_id="retire-me", messages=messages, focus="PRIVATE-FOCUS")
+    assert replay["id"] == intent["id"] and replay["body_retired"]
+    assert service.runtime.reviews == 1
+
+
+def test_partial_mutation_is_preserved_when_review_failed():
+    state = SimpleNamespace(result=None, review_usage={"input_tokens": 20}, review_messages=[
+        {"role": "assistant", "tool_calls": [{"id": "m", "function": {"name": "memory", "arguments": '{"action":"add"}'}}]},
+        {"role": "tool", "tool_call_id": "m", "content": json.dumps({"success": True, "message": "Entry added"})},
+    ])
+    outcome = review_outcome(state, "provider disconnected")
+    assert outcome["run_status"] == "failed" and len(outcome["applied"]) == 1
+    assert not outcome["no_change"]
+
+
+def test_staged_changes_are_not_applied_and_no_result_is_not_no_change():
+    state = SimpleNamespace(result=None, review_usage={}, review_messages=[
+        {"role": "assistant", "tool_calls": [{"id": "m", "function": {"name": "memory", "arguments": '{"action":"patch"}'}}]},
+        {"role": "tool", "tool_call_id": "m", "content": json.dumps({"success": True, "staged": True})},
+    ])
+    outcome = review_outcome(state)
+    assert len(outcome["staged"]) == 1 and not outcome["applied"]
+    assert outcome["run_status"] == "unknown" and not outcome["no_change"]
+
+
+def test_restart_marks_started_attempt_unknown_instead_of_rerunning(service):
+    from agent.learning_service import LearningService
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="event")
+    intent = service.maintenance(handle=handle, idle_flush=True)["intent"]
+    with service.db:
+        service.db.execute("UPDATE intents SET status='running' WHERE id=?", (intent,))
+        service.db.execute("INSERT INTO attempts VALUES (?,?,'running',?)", ("started", intent, '{"id":"started"}'))
+    home = service.home
+    service.close()
+    recovered = LearningService(home, "fixture")
+    try:
+        result = recovered.run_review(handle, intent, attempt_id="started")
+        assert result["run_status"] == "unknown"
+        assert recovered.runtime.reviews == 0
+    finally:
+        recovered.close()
+
+
+def test_retry_preserves_partial_writes_staged_proposals_and_original_attempt(service):
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="capture")
+    intent = service.maintenance(handle=handle, idle_flush=True)["intent"]
+    applied = {"tool": "skill_manage", "action": "create", "name": "learned-fixture", "result": {"success": True}}
+    staged = {"tool": "memory", "result": {"success": True, "staged": True, "pending_id": "pending-fixture"}}
+    failed = {"run_status": "failed", "error": "HTTP 429: limited", "applied": [applied], "staged": [staged], "uncertain": []}
+    service.runtime.review = lambda *_: failed
+    service.run_review(handle, intent, attempt_id="failed")
+    retry = service.retry_review(handle, intent, failed_attempt_id="failed")
+    assert service.retry_review(handle, intent, failed_attempt_id="failed") == retry
+    child = next(item for item in service.read(kind="status")["intents"] if item["id"] == retry["intent_id"])
+    assert child["revision"] == 1 and child["retry_root"] == intent and child["retry_index"] == 1
+    assert child["recovery"]["applied"][0]["name"] == "learned-fixture"
+    assert child["recovery"]["staged"][0]["pending_id"] == "pending-fixture"
+    service.runtime.review = lambda *_: {"run_status": "completed", "applied": [], "staged": [], "uncertain": []}
+    assert service.run_review(handle, retry["intent_id"], attempt_id="retry")["run_status"] == "completed"
+    retained = service.run_review(handle, intent, attempt_id="failed")
+    assert retained["run_status"] == "failed" and retained["applied"] == [applied] and retained["staged"] == [staged]
+
+
+@pytest.mark.parametrize("status,uncertain", [("unknown", []), ("failed", ["tool result missing"])])
+def test_retry_refuses_unconfirmed_results_and_cross_scope(service, status, uncertain):
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="capture")
+    intent = service.maintenance(handle=handle, idle_flush=True)["intent"]
+    service.runtime.review = lambda *_: {"run_status": status, "error": "TimeoutError", "uncertain": uncertain}
+    service.run_review(handle, intent, attempt_id="failed")
+    with pytest.raises(ValueError, match="original scope"):
+        service.retry_review("foreign-handle", intent, failed_attempt_id="failed")
+    with pytest.raises(ValueError, match="confirmed"):
+        service.retry_review(handle, intent, failed_attempt_id="failed")
+
+
+def test_retry_limit_and_newer_completed_revision_stop_old_work(service):
+    handle = service.open(source())["handle"]
+    service.observe(handle, body(), event_id="capture")
+    intent = service.maintenance(handle=handle, idle_flush=True)["intent"]
+    service.runtime.review = lambda *_: {"run_status": "failed", "error": "HTTP 503", "uncertain": []}
+    service.run_review(handle, intent, attempt_id="failed")
+    retry = service.retry_review(handle, intent, failed_attempt_id="failed", max_retries=1)
+    service.run_review(handle, retry["intent_id"], attempt_id="retry")
+    assert service.retry_review(handle, retry["intent_id"], failed_attempt_id="retry", max_retries=1)["status"] == "exhausted"
+    next_intent = service.observe(handle, body("turn-2"), event_id="capture-2")["intent"]
+    service.runtime.review = lambda *_: {"run_status": "completed", "uncertain": []}
+    service.run_review(handle, next_intent, attempt_id="newer")
+    assert service.retry_review(handle, retry["intent_id"], failed_attempt_id="retry")["status"] == "superseded"
+
+
+def test_recovery_scan_is_bounded_and_paginates_all_old_failures(service):
+    service.runtime.review = lambda *_: {"run_status": "failed", "error": "HTTP 429", "uncertain": []}
+    for index in range(51):
+        identity = {**source(), "chat": f"chat-{index}"}
+        handle = service.open(identity)["handle"]
+        value = body()
+        value["source"]["chat"] = identity["chat"]
+        service.observe(handle, value, event_id=f"capture-{index}")
+        intent = service.maintenance(handle=handle, idle_flush=True)["intent"]
+        service.run_review(handle, intent, attempt_id=f"failed-{index}")
+    first = service.read(kind="review_recovery")
+    assert len(first["items"]) == 50 and first["has_more"]
+    second = service.read(kind="review_recovery", after_cursor=first["next_cursor"])
+    assert len(second["items"]) == 1 and not second["has_more"]
+    assert len({item["attempt"]["id"] for item in first["items"] + second["items"]}) == 51
+
+
+def test_prior_observed_tool_writes_are_not_reported_as_new_learning():
+    prior = [
+        {"role": "assistant", "tool_calls": [{"id": "old", "function": {"name": "memory", "arguments": '{"action":"add"}'}}]},
+        {"role": "tool", "tool_call_id": "old", "content": '{"success":true}'},
+    ]
+    state = SimpleNamespace(result={"completed": True}, review_usage={}, review_messages=prior)
+    result = review_outcome(state, prior_snapshot=prior)
+    assert result["no_change"] and not result["applied"]
+
+
+def test_native_batch_skill_identity_is_preserved():
+    operations = [{"name": "build-verify", "action": "create", "success": True},
+                  {"name": "build-verify", "action": "patch", "success": True}]
+    state = SimpleNamespace(result={"completed": True}, review_usage={}, review_messages=[
+        {"role": "assistant", "tool_calls": [{"id": "batch", "function": {
+            "name": "skill_manage", "arguments": json.dumps({"operations": operations})}}]},
+        {"role": "tool", "tool_call_id": "batch", "content": json.dumps({
+            "success": True, "operations_applied": 2, "results": operations})},
+    ])
+    result = review_outcome(state)
+    assert [fact["name"] for fact in result["applied"]] == ["build-verify", "build-verify"]
+    assert [fact["action"] for fact in result["applied"]] == ["create", "patch"]
+
+
+def test_prior_v1_batch_receipts_still_recall_updated_skill(service):
+    outcome = {"applied": [{"tool": "skill_manage", "name": None,
+                           "operation": {"name": "build-verify", "action": "create", "success": True}}]}
+    with service.db:
+        service.db.execute("INSERT INTO attempts VALUES (?,?,'completed',?)",
+                           ("legacy-batch", "intent", json.dumps(outcome)))
+    assert "新更新技能：build-verify" in service.read(kind="context")["summary"]
