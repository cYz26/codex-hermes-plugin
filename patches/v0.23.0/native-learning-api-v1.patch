+    @_bound
+    def close_review_without_retry(self, handle: str, intent_id: str, *, attempt_id: str,
+                                  outcome_hash: str, artifact_versions: dict, note: str, evidence: str) -> dict:
+        """Record a checked explicit skill-only outcome without replaying or rewriting it.
+
+        This does not declare success. Unknown/pending writes and memory changes require
+        their own native reconciliation; current artifact inspection cannot resolve them.
+        """
+        from agent.learning_artifacts import skill
+        if not all(isinstance(v, str) and 0 < len(v.strip()) <= 2000
+                   for v in (handle, intent_id, attempt_id, outcome_hash, note, evidence)):
+            raise ValueError("Inspection requires bounded identities, note and evidence")
+        if not isinstance(artifact_versions, dict) or not artifact_versions or not all(
+                isinstance(k, str) and isinstance(v, str) and k and v for k, v in artifact_versions.items()):
+            raise ValueError("Inspect all affected current artifact versions")
+        inspection = dict(attempt_id=attempt_id, outcome_hash=outcome_hash,
+                          artifact_versions=artifact_versions, note=note, evidence=evidence)
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM intents WHERE id=? AND handle=?", (intent_id, handle)).fetchone()
+            attempt = self.db.execute("SELECT * FROM attempts WHERE id=? AND intent=?", (attempt_id, intent_id)).fetchone()
+            if row is None or attempt is None:
+                raise ValueError("Inspection must match the original scope and attempt")
+            intent, outcome = json.loads(row["payload"]), json.loads(attempt["payload"])
+            if intent.get("resolution"):
+                prior = intent["resolution"]
+                if prior["inspection"] != inspection:
+                    raise ValueError("An existing inspection cannot be replaced")
+                return prior
+            if (row["status"] != "unknown" or attempt["status"] != "unknown"
+                    or intent.get("reason") != "user_request" or intent.get("memory")
+                    or fingerprint(outcome) != outcome_hash):
+                raise ValueError("Only the exact inspected unknown explicit skill review may be closed")
+            applied = outcome.get("applied") or []
+            if (any(outcome.get(key) for key in ("uncertain", "staged", "refused")) or not applied
+                    or any(item.get("tool") != "skill_manage" or not changed_skill_name(item) for item in applied)):
+                raise ValueError("Unconfirmed, staged, refused or non-skill operations require native reconciliation")
+            names = {changed_skill_name(item) for item in applied}
+            if names != set(artifact_versions) or any(skill(self.home, name)["version"] != artifact_versions[name] for name in names):
+                raise ValueError("Affected artifacts changed or the inspection is incomplete")
+            result = {"state": "closed_without_retry", "inspection": inspection,
+                      "original_status": "unknown", "at": time.time()}
+            intent["resolution"] = result
+            # Preserve the complete attempt verbatim. Only the intent disposition changes;
+            # run_review still returns its original outcome and retry_review still refuses it.
+            self.db.execute("UPDATE intents SET status='closed_without_retry',payload=? WHERE id=?",
+                            (json.dumps(intent), intent_id))
+            return result
+
+    @_bound
+    def retry_review(self, handle: str, intent_id: str, *, failed_attempt_id: str,
+                     max_retries: int = 3) -> dict:
+        """Queue an idempotent successor; never erase or replay the old attempt."""
+        if isinstance(max_retries, bool) or not isinstance(max_retries, int) or not 1 <= max_retries <= 10:
+            raise ValueError("Review retries must be bounded between one and ten")
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM intents WHERE id=? AND handle=?", (intent_id, handle)).fetchone()
+            previous = self.db.execute("SELECT * FROM attempts WHERE id=? AND intent=?",
+                                       (failed_attempt_id, intent_id)).fetchone()
+            if row is None or previous is None:
+                raise ValueError("Retry requires the failed attempt in its original scope")
+            outcome = json.loads(previous["payload"])
+            if previous["status"] not in {"failed", "interrupted"} or outcome.get("uncertain"):
+                raise ValueError("Review outcome must be confirmed before retrying")
+            parent = json.loads(row["payload"])
+            if parent.get("reason") == "user_request" or parent.get("request_id") or parent.get("attended"):
+                raise ValueError("Explicit learning requests are outside automatic review recovery")
+            index = parent.get("retry_index", 0)
+            if index >= max_retries:
+                return {"status": "exhausted", "retry_index": index}
+            identity = fingerprint([intent_id, failed_attempt_id, "retry"])
+            existing = self.db.execute("SELECT status FROM intents WHERE id=?", (identity,)).fetchone()
+            if existing:
+                return {"intent_id": identity, "status": existing["status"], "retry_index": index + 1}
+            if row["revision"] <= self._scope(handle)["reviewed"]:
+                return {"status": "superseded", "retry_index": index}
+            recovery = {key: list(parent.get("recovery", {}).get(key, [])) for key in ("applied", "staged")}
+            for key in ("applied", "staged"):
+                for fact in outcome.get(key, []):
+                    if not isinstance(fact, dict):
+                        continue
+                    operation = fact.get("operation") or fact
+                    result = fact.get("result") or {}
+                    recovery[key].append({key: value for key, value in {
+                        "tool": fact.get("tool"), "action": operation.get("action"),
+                        "name": operation.get("name"), "target": operation.get("target"),
+                        "file_path": operation.get("file_path"), "call_id": fact.get("call_id"),
+                        "pending_id": result.get("pending_id"),
+                    }.items() if value is not None})
+            value = {**{key: parent[key] for key in ("handle", "revision", "memory", "skills")},
+                     "id": identity, "reason": "retry", "retry_of": intent_id,
+                     "retry_root": parent.get("retry_root", intent_id), "retry_index": index + 1,
+                     "recovery": recovery}
+            self.db.execute("INSERT INTO intents VALUES (?,?,?,'queued',?)",
+                            (identity, handle, row["revision"], json.dumps(value)))
+            return {"intent_id": identity, "status": "queued", "retry_index": index + 1}
+
+    @_bound
+    def read(self, *, kind: str, name: str | None = None, file_path: str | None = None,
+             issue_receipt: bool = True, detail: str = "full", artifact_version: str | None = None,
+             after_cursor: int = 0) -> dict:
+        if kind == "capabilities":
+            return {"version":1, "artifact_preview":True, "bounded_status":True, "retention":True,"snapshot_delivery":True,
+                    "explicit_reviews":True, "review_retry":True, "review_inspection":True, "skill_lifecycle":True, "artifact_retention":True}
+        if kind == "skill_lifecycle":
+            from agent.learning_maintenance import history
+            return history(name)
+        if kind == "curator_status":
+            from agent.learning_maintenance import status
+            return status()
+        if kind == "request":
+            with self.lock:
+                row = self.db.execute("SELECT i.* FROM intents i JOIN explicit_reviews e ON e.intent=i.id WHERE e.id=?", (name,)).fetchone()
+                if row is None:
+                    raise ValueError("Unknown explicit request")
+                attempt = self.db.execute("SELECT * FROM attempts WHERE intent=?", (row["id"],)).fetchone()
+                return {"intent": {**json.loads(row["payload"]), "status": row["status"]},
+                        "attempt": {**json.loads(attempt["payload"]), "id":attempt["id"], "run_status":attempt["status"]} if attempt else None}
+        if kind == "review_recovery":
+            if isinstance(after_cursor, bool) or not isinstance(after_cursor, int) or not 0 <= after_cursor < 2**63:
+                raise ValueError("Recovery cursor must be a nonnegative journal position")
+            with self.lock:
+                rows = self.db.execute(
+                    "SELECT i.rowid cursor,i.payload intent,i.status intent_status,a.id attempt_id,a.status attempt_status,"
+                    "a.payload outcome,s.source FROM intents i JOIN scopes s ON s.id=i.handle "
+                    "LEFT JOIN attempts a ON a.intent=i.id WHERE i.rowid>? "
+                    "AND (a.status IN ('failed','interrupted','unknown') OR "
+                    "(i.status IN ('completed','superseded') AND json_extract(i.payload,'$.retry_root') IS NOT NULL)) "
+                    "AND NOT EXISTS (SELECT 1 FROM intents child WHERE json_extract(child.payload,'$.retry_of')=i.id) "
+                    "ORDER BY i.rowid LIMIT 51", (after_cursor,)).fetchall()
+                items = []
+                for row in rows[:50]:
+                    items.append({"intent": {**json.loads(row["intent"]), "status": row["intent_status"]},
+                                  "attempt": {**json.loads(row["outcome"] or "{}"), "id": row["attempt_id"],
+                                              "run_status": row["attempt_status"] or row["intent_status"]},
+                                  "source": json.loads(row["source"])})
+                return {"items": items, "next_cursor": rows[min(len(rows),50)-1]["cursor"] if rows else after_cursor,
+                        "has_more": len(rows)>50}
+        if kind == "retention_state":
+            with self.lock:
+                row = self.db.execute("SELECT r.revision>=s.revision retired FROM retired_scopes r "
+                                      "JOIN scopes s ON s.id=r.handle WHERE r.handle=?", (name,)).fetchone()
+                return {"retired":bool(row and row["retired"])}
+        if kind == "context":
+            from agent.learning_artifacts import context
+            value = context(self.home)
+            recalled = "\n".join(getattr(self.runtime, "recalled", {}).values())
+            value["provider_recall"] = recalled
+            recent = []
+            with self.lock:
+                for row in self.db.execute("SELECT payload FROM attempts WHERE status='completed' ORDER BY rowid DESC LIMIT 3"):
+                    for fact in json.loads(row[0]).get("applied", []):
+                        name = changed_skill_name(fact)
+                        if name and name not in recent:
+                            recent.append(name)
+            if recent:
+                memory = "\n".join(value["memories"].values())[:340]
+                value["summary"] = memory + "\n新更新技能：" + "、".join(recent[:5])
+            if recalled:
+                value["summary"] += "\n" + recalled[:180]
+            value["version"] = fingerprint([value["version"], recalled])
+            return value
+        if kind == "skill":
+            from agent.learning_artifacts import skill, snapshot
+            value = snapshot(self.home, name, artifact_version, file_path) if artifact_version else skill(self.home, name, file_path)
+            if not issue_receipt:
+                return value
+            token = uuid.uuid4().hex
+            with self.lock, self.db:
+                self.db.execute("INSERT INTO deliveries VALUES (?,?,?,'issued',NULL)", (token, value["name"], value["version"]))
+            return {**value, "delivery_token": token}
+        if kind == "status":
+            if detail == "summary":
+                with self.lock:
+                    intents = [{**json.loads(r["payload"]), "status":r["status"]} for r in self.db.execute(
+                        "SELECT * FROM intents WHERE status IN ('queued','running','unknown') ORDER BY rowid LIMIT 100")]
+                    attempts = [{"id":r["id"],"run_status":r["status"]} for r in self.db.execute(
+                        "SELECT id,status FROM attempts ORDER BY rowid DESC LIMIT 10")]
+                    counts = {table:self.db.execute("SELECT COUNT(*) FROM " + table).fetchone()[0]
+                              for table in ("scopes","observations","attempts","deliveries")}
+                    usage = {key:self.db.execute("SELECT COALESCE(SUM(json_extract(payload,?)),0) FROM attempts",
+                                                  ("$.usage."+key,)).fetchone()[0]
+                             for key in ("input_tokens","output_tokens","cache_read_tokens","api_calls")}
+                    return {"version":1,"intents":intents,"attempts":attempts,"counts":counts,
+                            "usage":{"native_review_attempts":usage,"telemetry":"best_effort","paid_cost":None},
+                            "retention":{"scopes":self.db.execute("SELECT COUNT(*) FROM retired_scopes").fetchone()[0]}}
+            with self.lock:
+                intents = [{**json.loads(r["payload"]), "status": r["status"]} for r in self.db.execute("SELECT * FROM intents")]
+                attempts = [{**json.loads(r["payload"]), "id": r["id"], "run_status": r["status"]} for r in self.db.execute("SELECT * FROM attempts")]
+                gaps = [dict(r) for r in self.db.execute("SELECT id,projection,provider FROM observations WHERE projection!='projected'")]
+                handles = [r[0] for r in self.db.execute("SELECT id FROM scopes")]
