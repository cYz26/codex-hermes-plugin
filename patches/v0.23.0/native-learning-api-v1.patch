+    @_bound
+    def prune_artifacts(self, protected_versions: list[str], *, retention_seconds: float = 30 * 86400,
+                        dry_run: bool = True) -> dict:
+        from agent.learning_maintenance import prune_artifacts
+        with self.lock:
+            protected = set(protected_versions)
+            protected.update(row[0] for row in self.db.execute('SELECT DISTINCT version FROM deliveries'))
+            return prune_artifacts(self.home, list(protected), retention_seconds=retention_seconds, dry_run=dry_run)
