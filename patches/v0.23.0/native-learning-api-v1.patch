+"""Learning API v1: profile-bound values, native execution, durable admission receipts.
+
+The learning journal owns admission/counters atomically. Native transcript projection is
+recoverable via deterministic message UIDs. Remote provider writes are explicitly not atomic
+with this journal: an interrupted projection is reported as uncertain, never blindly replayed.
+"""
+from __future__ import annotations
+
+import functools
+import json
+import logging
+import sqlite3
+import threading
+import time
+import uuid
+from pathlib import Path
+
+from agent.learning_artifacts import fingerprint
+from agent.learning_results import changed_skill_name
+
+logger = logging.getLogger(__name__)
+
+
+def _bound(method):
+    @functools.wraps(method)
+    def call(self, *args, **kwargs):
+        from hermes_cli.plugins_loader import _plugin_home_scope
+        with _plugin_home_scope(self.home):
+            return method(self, *args, **kwargs)
+    return call
+
+
+class LearningService:
+    version = 1
+
+    def __init__(self, home: Path, plugin_id: str):
+        from agent.learning_runtime import NativeLearningRuntime
+
+        self.home, self.plugin_id = Path(home).resolve(), plugin_id
+        root = self.home / "learning"
+        root.mkdir(exist_ok=True, mode=0o700)
+        # v1 has a single POSIX owner; plugin-host and multi-writer homes are unsupported.
+        import fcntl
+        self.owner = (root / "owner.lock").open("a+")
+        fcntl.flock(self.owner, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        self.lock = threading.RLock()
+        self.db = sqlite3.connect(root / "journal.sqlite", check_same_thread=False)
+        self.db.row_factory = sqlite3.Row
+        if self.db.execute("PRAGMA user_version").fetchone()[0] not in (0, 1, 2):
+            self.db.close()
+            self.owner.close()
+            raise ValueError("Unsupported learning journal schema")
+        self.db.execute("PRAGMA journal_mode=WAL")
+        self.db.execute("PRAGMA synchronous=FULL")
+        self.db.executescript("""
+          CREATE TABLE IF NOT EXISTS scopes (id TEXT PRIMARY KEY, source TEXT NOT NULL,
+            revision INTEGER DEFAULT 0, reviewed INTEGER DEFAULT 0, memory_count INTEGER DEFAULT 0,
+            skill_count INTEGER DEFAULT 0, activity REAL NOT NULL);
+          CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            turn TEXT NOT NULL, revision INTEGER NOT NULL, body TEXT NOT NULL, messages TEXT NOT NULL,
+            projection TEXT NOT NULL DEFAULT 'pending', provider TEXT);
+          CREATE TABLE IF NOT EXISTS calls (handle TEXT, turn TEXT, call_id TEXT,
+            PRIMARY KEY(handle,turn,call_id));
+          CREATE TABLE IF NOT EXISTS receipts (id TEXT PRIMARY KEY, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS intents (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            revision INTEGER NOT NULL, status TEXT NOT NULL, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS attempts (id TEXT PRIMARY KEY, intent TEXT NOT NULL UNIQUE,
+            status TEXT NOT NULL, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS deliveries (token TEXT PRIMARY KEY, name TEXT NOT NULL,
+            version TEXT NOT NULL, status TEXT NOT NULL, evidence TEXT);
+          CREATE TABLE IF NOT EXISTS closures (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            status TEXT NOT NULL, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS retired_observations(handle TEXT, turn TEXT, body_hash TEXT, event_id TEXT,
+            PRIMARY KEY(handle,turn,body_hash));
+          CREATE TABLE IF NOT EXISTS retired_scopes(handle TEXT PRIMARY KEY, revision INTEGER, retired_at REAL);
+          CREATE TABLE IF NOT EXISTS explicit_reviews(id TEXT PRIMARY KEY, intent TEXT NOT NULL UNIQUE,
+            fingerprint TEXT NOT NULL, messages TEXT NOT NULL, created REAL NOT NULL);
+          CREATE INDEX IF NOT EXISTS intents_retry_parent ON intents(json_extract(payload,'$.retry_of'));
+        """)
+        with self.db:
+            # Successor intents need recovery-aware execution. Older owners reject
+            # schema 2 instead of executing them without the recovery guard.
+            self.db.execute("PRAGMA user_version=2")
+            self.db.execute("UPDATE attempts SET status='unknown' WHERE status='running'")
+            self.db.execute("UPDATE intents SET status='unknown' WHERE status='running'")
+            self.db.execute("UPDATE observations SET projection='uncertain' WHERE projection='projecting'")
+            self.db.execute("UPDATE closures SET status='unknown' WHERE status='closing'")
+        self.runtime = NativeLearningRuntime()
+        self.closed = False
+
+    def _scope(self, handle: str):
+        row = self.db.execute("SELECT * FROM scopes WHERE id=?", (handle,)).fetchone()
+        if row is None:
+            raise ValueError("Unknown learning handle")
+        return row
+
+    @_bound
+    def open(self, source: dict) -> dict:
+        identity_keys = {"host", "project", "chat"}
+        if not identity_keys <= set(source) or set(source) - identity_keys - {"executor"}:
+            raise ValueError("Unknown observation source fields")
+        if not all(isinstance(v, str) and v for v in source.values()):
+            raise ValueError("source requires host, absolute project and actual chat identity")
+        if len(source.get("executor", "")) > 80:
+            raise ValueError("executor label is too long")
+        if not Path(source["project"]).is_absolute():
+            raise ValueError("project must be absolute")
+        handle = "observed-" + fingerprint({k: source[k] for k in identity_keys})[:32]
+        with self.lock, self.db:
+            self.db.execute("INSERT OR IGNORE INTO scopes(id,source,activity) VALUES (?,?,?)",
+                            (handle, json.dumps(source), time.time()))
+        return {"handle": handle, "version": 1}
+
+    def _messages(self, body: dict, identity: str, new_turn: bool, known_calls: set) -> list[dict]:
+        messages = [{"role": "user", "content": body["user"] if new_turn else
+                     "[Supplemental external execution evidence for the prior turn; not a new user request.]"}]
+        for tool in body.get("tools", []):
+            if tool["call_id"] in known_calls or tool["status"] not in {"completed", "failed", "interrupted"}:
+                continue
+            call_id = "external-" + fingerprint([body["source"], tool["call_id"]])[:32]
+            messages.extend([
+                {"role": "assistant", "content": None, "tool_calls": [{"id": call_id, "type": "function",
+                  "function": {"name": tool["name"], "arguments": json.dumps(tool.get("arguments", {}))}}]},
+                {"role": "tool", "tool_call_id": call_id, "tool_name": tool["name"],
+                 "content": tool["result"] if isinstance(tool["result"], str) else json.dumps(tool["result"], ensure_ascii=False)},
+            ])
+        if body.get("assistant"):
+            messages.append({"role": "assistant", "content": body["assistant"]})
+        for index, msg in enumerate(messages):
+            msg.update(message_uid=fingerprint([identity, index]), observed=True)
+        return messages
+
+    @_bound
+    def observe(self, handle: str, observation: dict, *, event_id: str) -> dict:
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT payload FROM receipts WHERE id=?", (event_id,)).fetchone()
+            body_hash = fingerprint(observation)
+            if previous:
+                receipt = json.loads(previous[0])
+                if receipt["content_hash"] != body_hash or receipt["handle"] != handle:
+                    raise ValueError("Observation identity conflict")
+                return receipt
+            scope = self._scope(handle)
+            body = observation
+            expected = json.loads(scope["source"])
+            if any(body["source"][k] != expected[k] for k in ("host", "project", "chat")):
+                raise ValueError("Observation scope mismatch")
+            if body.get("status") not in {"completed", "interrupted"} or not isinstance(body.get("user"), str):
+                raise ValueError("Only terminal observed turns are accepted")
+            turn = body["source"]["turn"]
+            retired = self.db.execute("SELECT event_id FROM retired_observations WHERE handle=? AND turn=? AND body_hash=?",
+                                      (handle, turn, body_hash)).fetchone()
+            if retired:
+                receipt = json.loads(self.db.execute("SELECT payload FROM receipts WHERE id=?", (retired[0],)).fetchone()[0])
+                receipt = {**receipt, "id":event_id, "duplicate_of":retired[0]}
+                self.db.execute("INSERT INTO receipts VALUES (?,?)", (event_id, json.dumps(receipt)))
+                return receipt
+            same = self.db.execute("SELECT id FROM observations WHERE handle=? AND turn=? AND body=?",
+                                   (handle, turn, json.dumps(body, sort_keys=True))).fetchone()
+            if same:
+                receipt = json.loads(self.db.execute("SELECT payload FROM receipts WHERE id=?", (same[0],)).fetchone()[0])
+                receipt = {**receipt, "id": event_id, "duplicate_of": same[0]}
+                self.db.execute("INSERT INTO receipts VALUES (?,?)", (event_id, json.dumps(receipt)))
+                return receipt
+            new_turn = not self.db.execute("SELECT 1 FROM observations WHERE handle=? AND turn=?", (handle, turn)).fetchone()
+            known = {r[0] for r in self.db.execute("SELECT call_id FROM calls WHERE handle=? AND turn=?", (handle, turn))}
+            messages = self._messages(body, event_id, new_turn, known)
+            calls = {t["call_id"] for t in body.get("tools", []) if t["status"] in {"completed", "failed", "interrupted"}} - known
+            ticks = self.runtime.tick(handle, json.loads(scope["source"]), scope["memory_count"], scope["skill_count"],
+                                      new_turn=new_turn, tools=len(calls))
+            revision = scope["revision"] + 1
+            self.db.execute("INSERT INTO observations(id,handle,turn,revision,body,messages) VALUES (?,?,?,?,?,?)",
+                            (event_id, handle, turn, revision, json.dumps(body, sort_keys=True), json.dumps(messages)))
+            self.db.executemany("INSERT INTO calls VALUES (?,?,?)", [(handle, turn, call) for call in calls])
+            self.db.execute("UPDATE scopes SET revision=?,memory_count=?,skill_count=?,activity=? WHERE id=?",
+                            (revision, ticks["memory_count"], ticks["skill_count"], time.time(), handle))
+            intent = None
+            if body["status"] == "completed" and body.get("assistant") and (ticks["memory"] or ticks["skills"]):
+                intent = self._intent(handle, revision, ticks["memory"], ticks["skills"], "native_threshold")
+            receipt = {"id": event_id, "handle": handle, "revision": revision, "content_hash": body_hash,
+                       "new_user_turn": new_turn, "completed_tool_delta": len(calls), "intent": intent,
+                       "coverage": body.get("coverage", []),
+                       "count_confidence": "observed_only" if body.get("coverage") else "source_ids"}
+            self.db.execute("INSERT INTO receipts VALUES (?,?)", (event_id, json.dumps(receipt)))
+        self._project(event_id)
+        return receipt
+
+    def _intent(self, handle, revision, memory, skills, reason):
+        identity = fingerprint([handle, revision, reason])
+        value = {"id": identity, "handle": handle, "revision": revision, "memory": memory, "skills": skills, "reason": reason}
+        self.db.execute("INSERT OR IGNORE INTO intents VALUES (?,?,?,'queued',?)",
+                        (identity, handle, revision, json.dumps(value)))
+        return identity
+
+    def _project(self, identity):
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM observations WHERE id=?", (identity,)).fetchone()
+            if row["projection"] != "pending":
+                return
+            self.db.execute("UPDATE observations SET projection='projecting' WHERE id=?", (identity,))
+        body = json.loads(row["body"])
+        provider = self.runtime.project(row["handle"], json.loads(self._scope(row["handle"])["source"]), json.loads(row["messages"]),
+                                        user=body["user"], assistant=body.get("assistant", ""), sync=body["status"] == "completed")
+        with self.lock, self.db:
+            self.db.execute("UPDATE observations SET projection='projected',provider=? WHERE id=?", (provider, identity))
+
+    @_bound
+    def request_review(self, handle: str, *, request_id: str, messages: list[dict], focus: str = "",
+                       memory: bool = True, skills: bool = True, attended: bool = False) -> dict:
+        """Queue an admitted immutable snapshot, independently of automatic review counters.
+
+        The owning integration admits the evidence and authorizes the write scope. Explicit
+        scheduling alone does not authorize attended memory replacement/removal.
+        """
+        if not isinstance(request_id, str) or not request_id or len(request_id) > 128:
+            raise ValueError("Invalid request identity")
+        if not isinstance(focus, str) or len(focus.encode()) > 16384:
+            raise ValueError("Invalid review focus")
+        if any(type(v) is not bool for v in (memory, skills, attended)) or not (memory or skills):
+            raise ValueError("Invalid review scope")
+        if not isinstance(messages, list) or not messages or any(not isinstance(m, dict) or
+                m.get("role") not in {"user", "assistant", "tool"} for m in messages):
+            raise ValueError("A bounded evidence snapshot is required")
+        snapshot = json.dumps(messages, ensure_ascii=False)
+        if len(snapshot.encode()) > 65536:
+            raise ValueError("Review snapshot exceeds 64 KiB")
+        signature = fingerprint([handle, messages, focus, memory, skills, attended])
+        with self.lock, self.db:
+            scope = self._scope(handle)
+            old = self.db.execute("SELECT * FROM explicit_reviews WHERE id=?", (request_id,)).fetchone()
+            if old:
+                if old["fingerprint"] != signature:
+                    raise ValueError("Explicit request identity conflict")
+                row = self.db.execute("SELECT payload FROM intents WHERE id=?", (old["intent"],)).fetchone()
+                return json.loads(row[0])
+            if self.db.execute("SELECT 1 FROM intents WHERE handle=? AND status='unknown'", (handle,)).fetchone():
+                raise ValueError("An uncertain review in this scope requires inspection before another request")
+            intent_id = fingerprint(["user_request", request_id, handle])
+            value = {"id": intent_id, "handle": handle, "revision": scope["revision"], "memory": memory,
+                     "skills": skills, "reason": "user_request", "request_id": request_id,
+                     "focus": focus, "attended": attended}
+            self.db.execute("INSERT INTO explicit_reviews VALUES (?,?,?,?,?)",
+                            (request_id, intent_id, signature, snapshot, time.time()))
+            self.db.execute("INSERT INTO intents VALUES (?,?,?,'queued',?)",
+                            (intent_id, handle, scope["revision"], json.dumps(value)))
+            self.db.execute("UPDATE scopes SET activity=? WHERE id=?", (time.time(), handle))
+            return value
+
+    @_bound
+    def cancel_request(self, request_id: str) -> dict:
+        with self.lock, self.db:
+            row = self.db.execute("SELECT i.id,i.status FROM intents i JOIN explicit_reviews e ON e.intent=i.id WHERE e.id=?",
+                                  (request_id,)).fetchone()
+            if row is None:
+                raise ValueError("Unknown explicit request")
+            if row["status"] == "queued":
+                self.db.execute("UPDATE intents SET status='cancelled' WHERE id=?", (row["id"],))
+                return {"status": "cancelled", "rollback": False}
+            return {"status": row["status"], "rollback": False}
+
+    @_bound
+    def run_review(self, handle: str, intent_id: str, *, attempt_id: str) -> dict:
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT * FROM attempts WHERE intent=? OR id=?", (intent_id, attempt_id)).fetchone()
+            if previous:
+                if previous["intent"] != intent_id:
+                    raise ValueError("Attempt identity conflict")
+                return {**json.loads(previous["payload"]), "run_status": previous["status"]}
+            row = self.db.execute("SELECT * FROM intents WHERE id=? AND handle=?", (intent_id, handle)).fetchone()
+            if row is None or row["status"] != "queued":
+                raise ValueError("Review intent is not queued for this scope")
+            if self.db.execute("SELECT 1 FROM attempts WHERE status='running'").fetchone():
+                return {"run_status": "deferred", "reason": "another_review_running"}
+            intent = json.loads(row["payload"])
+            explicit = intent.get("reason") == "user_request"
+            if not explicit and self.db.execute("SELECT 1 FROM observations WHERE handle=? AND revision<=? AND projection!='projected'",
+                               (handle, row["revision"])).fetchone():
+                return {"run_status": "deferred", "reason": "projection_incomplete"}
+            scope = self._scope(handle)
+            if not explicit and row["revision"] <= scope["reviewed"]:
+                self.db.execute("UPDATE intents SET status='superseded' WHERE id=?", (intent_id,))
+                return {"run_status": "superseded"}
+            self.db.execute("INSERT INTO attempts VALUES (?,?,'running',?)", (attempt_id, intent_id, json.dumps({"id": attempt_id})))
+            self.db.execute("UPDATE intents SET status='running' WHERE id=?", (intent_id,))
+            messages = json.loads(self.db.execute("SELECT messages FROM explicit_reviews WHERE intent=?", (intent_id,)).fetchone()[0]) if explicit else [m for r in self.db.execute("SELECT messages FROM observations WHERE handle=? AND revision<=? ORDER BY revision",
+                                                   (handle, row["revision"])) for m in json.loads(r[0])]
+        try:
+            outcome = self.runtime.review(handle, json.loads(scope["source"]), messages, intent)
+        except Exception as exc:
+            logger.exception("Learning review attempt failed")
+            outcome = {"run_status": "unknown", "error": f"{type(exc).__name__}: {exc}", "uncertain": ["executor raised"]}
+        with self.lock, self.db:
+            state = outcome["run_status"]
+            if state == "deferred":
+                self.db.execute("DELETE FROM attempts WHERE id=?", (attempt_id,))
+                self.db.execute("UPDATE intents SET status='queued' WHERE id=?", (intent_id,))
+            else:
+                self.db.execute("UPDATE attempts SET status=?,payload=? WHERE id=?", (state, json.dumps(outcome), attempt_id))
+                self.db.execute("UPDATE intents SET status=? WHERE id=?", (state, intent_id))
