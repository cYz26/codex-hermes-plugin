@@ -0,0 +1,35 @@
+"""The public plugin facade binds its manager's profile and requires explicit opt-in."""
+import pytest
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+def test_learning_facade_is_opt_in_versioned_and_profile_bound(tmp_path, monkeypatch):
+    from hermes_cli.config import DEFAULT_CONFIG, atomic_config_write
+    from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+
+    owner, ambient = tmp_path / "owner", tmp_path / "ambient"
+    owner.mkdir()
+    ambient.mkdir()
+    path = owner / "config.yaml"
+    cfg = {"_config_version": DEFAULT_CONFIG["_config_version"], "plugins": {"entries": {
+        "fixture": {"settings": {"learning": {"enabled": False}}}}}}
+    atomic_config_write(path, cfg)
+    ctx = PluginContext(PluginManifest(name="fixture", source="user"), PluginManager(scope_key=str(owner)))
+    monkeypatch.setenv("HERMES_HOME", str(ambient))
+    with pytest.raises(ValueError, match="version"):
+        ctx.learning(version=2)
+    with pytest.raises(PermissionError):
+        ctx.learning(version=1)
+    cfg["plugins"]["entries"]["fixture"]["settings"]["learning"]["enabled"] = True
+    atomic_config_write(path, cfg)
+    api = ctx.learning(version=1)
+    try:
+        assert ctx.learning(version=1) is api
+        assert not any(hasattr(api, name) for name in ("db", "runtime", "agents", "owner"))
+        result = api.open({"host": "fixture", "project": str(tmp_path), "chat": "actual-chat"})
+        assert result["version"] == 1
+        assert (owner / "learning/journal.sqlite").exists()
+        assert not (ambient / "learning").exists()
+    finally:
+        api.close()
