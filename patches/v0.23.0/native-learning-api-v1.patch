+    @_bound
+    def prune(self, *, retention_seconds: float = 30 * 86400, dry_run: bool = True) -> dict:
+        if not isinstance(dry_run, bool) or not 86400 <= retention_seconds <= 3650 * 86400:
+            raise ValueError("Retention requires a boolean preview and at least one day")
+        with self.lock:
+            rows = self.db.execute(
+                "SELECT s.id,s.revision FROM scopes s WHERE s.activity<? AND s.reviewed>=s.revision "
+                "AND NOT EXISTS (SELECT 1 FROM intents i WHERE i.handle=s.id AND i.status IN ('queued','running','unknown')) "
+                "AND NOT EXISTS (SELECT 1 FROM observations o WHERE o.handle=s.id AND o.projection!='projected') "
+                "AND NOT EXISTS (SELECT 1 FROM retired_scopes r WHERE r.handle=s.id AND r.revision>=s.revision) "
+                "ORDER BY s.activity LIMIT 100", (time.time()-retention_seconds,)).fetchall()
+            result = {"eligible_scopes":len(rows), "eligible_handles":[row["id"] for row in rows],
+                      "retired_scopes":0, "dry_run":dry_run}
+            explicit = self.db.execute("SELECT e.id,i.id intent,i.payload FROM explicit_reviews e JOIN intents i ON i.id=e.intent "
+                "WHERE e.created<? AND e.messages!='[]' AND i.status IN ('completed','failed','interrupted','cancelled') LIMIT 1000",
+                (time.time()-retention_seconds,)).fetchall()
+            result["eligible_explicit_requests"] = len(explicit)
+            if dry_run:
+                return result
+            with self.db:
+                for request in explicit:
+                    self.db.execute("UPDATE explicit_reviews SET messages='[]' WHERE id=?", (request["id"],))
+                    payload = json.loads(request["payload"])
+                    payload.pop("focus", None)
+                    payload["body_retired"] = True
+                    self.db.execute("UPDATE intents SET payload=? WHERE id=?", (json.dumps(payload),request["intent"]))
+                    attempt = self.db.execute("SELECT id,payload FROM attempts WHERE intent=?", (request["intent"],)).fetchone()
+                    if attempt:
+                        outcome = json.loads(attempt["payload"])
+                        summary = {key:outcome[key] for key in ("run_status","usage","id","intent_id") if key in outcome}
+                        summary.update(retired=True, applied_count=len(outcome.get("applied",[])), staged_count=len(outcome.get("staged",[])))
+                        self.db.execute("UPDATE attempts SET payload=? WHERE id=?", (json.dumps(summary),attempt["id"]))
+            for row in rows:
+                # Native projection storage owns its own retirement. Repeated deletion
+                # after interruption is safe; journal tombstones commit afterward.
+                self.runtime.prune_scope(row["id"])
+                with self.db:
+                    for observation in self.db.execute("SELECT id,turn,body FROM observations WHERE handle=?", (row["id"],)).fetchall():
+                        body = json.loads(observation["body"])
+                        if body.get("retired"):
