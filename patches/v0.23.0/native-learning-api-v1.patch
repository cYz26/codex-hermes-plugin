+"""Real native review loop against a loopback scripted provider; no business-model replay."""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.mark.parametrize("memory_action", ["add", "patch"])
+@pytest.mark.parametrize("trigger", ["automatic", "explicit"])
+def test_native_review_and_skill_delivery_have_real_effects(tmp_path, monkeypatch, memory_action, trigger):
+    calls = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *_):
+            return None
+
+        def do_POST(self):
+            request = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            if "messages" not in request:
+                self.send_response(404)
+                self.end_headers()
+                self.wfile.write(b'{}')
+                return
+            calls.append(request)
+            if len(calls) == 1:
+                tool_calls = [
+                    {"index": 0, "id": "call_memory", "type": "function", "function": {"name": "memory", "arguments": json.dumps({
+                        "action": memory_action, "target": "memory", "old_text": "Legacy validation uses mutable inputs.",
+                        "content": "Pilot validation uses the frozen input receipt before running checks."})}},
+                    {"index": 1, "id": "call_skill", "type": "function", "function": {"name": "skill_manage", "arguments": json.dumps({
+                        "action": "create", "name": "pilot-validation", "content": "---\nname: pilot-validation\ndescription: Validate this pilot using its frozen input receipt.\n---\nRead the receipt before checking the output.\n"})}},
+                ]
+                delta, reason = {"role": "assistant", "tool_calls": tool_calls}, "tool_calls"
+            else:
+                delta, reason = {"role": "assistant", "content": "Saved the verified validation procedure."}, "stop"
+            usage = {"prompt_tokens": 200, "completion_tokens": 30, "total_tokens": 230}
+            self.send_response(200)
+            if request.get("stream"):
+                self.send_header("Content-Type", "text/event-stream")
+                self.end_headers()
+                chunks = [{"choices": [{"index": 0, "delta": delta, "finish_reason": None}]},
+                          {"choices": [{"index": 0, "delta": {}, "finish_reason": reason}], "usage": usage}]
+                for chunk in chunks:
+                    self.wfile.write(("data: " + json.dumps({"id": "chatcmpl-pilot", "object": "chat.completion.chunk", "model": "gpt-4.1", **chunk}) + "\n\n").encode())
+                self.wfile.write(b"data: [DONE]\n\n")
+            else:
+                self.send_header("Content-Type", "application/json")
+                self.end_headers()
+                self.wfile.write(json.dumps({"id": "chatcmpl-pilot", "model": "gpt-4.1", "choices": [{"index": 0, "message": delta, "finish_reason": reason}], "usage": usage}).encode())
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    home = tmp_path / "home"
+    home.mkdir()
+    if memory_action == "patch":
+        (home / "memories").mkdir()
+        (home / "memories/MEMORY.md").write_text("Legacy validation uses mutable inputs.\n")
+    project = tmp_path / "project"
+    project.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("OPENAI_API_KEY", "local-scripted-provider")
+    from hermes_cli.config import DEFAULT_CONFIG, atomic_config_write
+    atomic_config_write(home / "config.yaml", {
+        "_config_version": DEFAULT_CONFIG["_config_version"],
+        "model": {"provider": "custom", "default": "gpt-4.1", "base_url": f"http://127.0.0.1:{server.server_port}/v1"},
+        "agent": {"reasoning_effort": "max"},
+        "memory": {"memory_enabled": True, "user_profile_enabled": True},
+        "auxiliary": {"background_review": {"enabled": trigger == "automatic"}},
+    })
+    from agent.learning_service import LearningService
+    from tools.skill_usage import get_record
+    api = LearningService(home, "native-loop-fixture")
+    try:
+        source = {"host": "test", "project": str(project), "chat": "chat-a"}
+        handle = api.open(source)["handle"]
+        api.observe(handle, {"source": {**source, "turn": "turn-1"}, "user": "Validate the frozen input first.",
+                             "assistant": "Validated the receipt and ran the checks successfully.", "status": "completed", "tools": []}, event_id="event-1")
+        assert calls == []
+        if trigger == "explicit":
+            intent = api.request_review(handle, request_id="explicit-fixture", focus="Save the verified receipt procedure",
+                messages=[{"role":"user","content":"The fixture validated its frozen input before checking output."}],
+                attended=memory_action == "patch")["id"]
+        else:
+            intent = api.maintenance(handle=handle, idle_flush=True)["intent"]
+        result = api.run_review(handle, intent, attempt_id="review-1")
+        assert result["run_status"] == "completed", result
+        assert len(result["applied"]) == (2 if memory_action == "add" or trigger == "explicit" else 1), result
+        if memory_action == "add" or trigger == "explicit":
+            assert "frozen input receipt" in api.read(kind="context")["memories"]["MEMORY.md"]
+        else:
+            assert len(result["staged"]) == 1, result
+            assert "Legacy validation" in api.read(kind="context")["memories"]["MEMORY.md"]
+        loaded = api.read(kind="skill", name="pilot-validation")
+        assert "Read the receipt" in loaded["content"]
+        before = get_record("pilot-validation").get("use_count", 0)
+        evidence = {"stage": "body_delivered", "source_event": ["chat-b", "turn-1", "load-1"]}
+        assert api.record_usage(loaded["delivery_token"], evidence)["recorded"]
+        assert not api.record_usage(loaded["delivery_token"], evidence)["recorded"]
+        assert get_record("pilot-validation")["use_count"] == before + 1
+        assert len(calls) == 2
+        assert result["usage"]["api_calls"] == 2
+        accounting = api.read(kind="status")["usage"]
+        assert accounting["source_execution"] is None
+        assert accounting["native_auxiliary_by_session"][handle]["background_review"]["input_tokens"] == result["usage"]["input_tokens"]
+        assert api.close(handle=handle, event_id="real-session-end")["status"] == "closed"
+        assert api.close(handle=handle, event_id="real-session-end")["status"] == "closed"
+    finally:
+        api.close()
+        server.shutdown()
+        server.server_close()
+
+
+def test_native_usage_is_read_after_observer_owner_restart(tmp_path, monkeypatch):
+    from agent.learning_runtime import NativeLearningRuntime
+    from hermes_state import SessionDB
+
+    home = tmp_path / "usage-profile"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    db = SessionDB()
+    db.record_auxiliary_usage("observed-fixture", "background_review", api_call_count=6, input_tokens=123)
+    db.close()
+    runtime = NativeLearningRuntime()
+    try:
+        usage = runtime.usage(["observed-fixture"])
+        assert usage["observed-fixture"]["background_review"]["api_calls"] == 6
+        assert usage["observed-fixture"]["background_review"]["input_tokens"] == 123
+        assert not runtime.agents
+    finally:
+        runtime.close()
