+def test_scheduled_maintenance_finishes_native_pass_before_return(monkeypatch):
+    from agent import curator
+    from agent.learning_maintenance import scheduled
+    calls = []
+    monkeypatch.setattr(curator, 'should_run_now', lambda: True)
+    monkeypatch.setattr(curator, 'get_min_idle_hours', lambda: 2)
+    monkeypatch.setattr(curator, '_claim_run', lambda: True)
+    monkeypatch.setattr(curator, '_release_run_claim', lambda: calls.append('released'))
+    def native(**kwargs):
+        assert kwargs == {'synchronous': True, 'trigger': 'scheduled'}
+        calls.append('completed')
+        return {'done': True}
+    monkeypatch.setattr(curator, 'run_curator_review', native)
+    assert scheduled(7199)['curator'] is None
+    assert calls == []
+    assert scheduled(7200)['curator'] == {'done': True}
+    assert calls == ['completed', 'released']
+
+
+def test_native_history_pages_and_only_accepts_verified_absorption(monkeypatch):
+    from tools import skill_ledger
+    from agent.learning_maintenance import history
+    rows = [{'id': str(i), 'action': 'delete', 'skill': 'old',
+             'evidence': {'absorbed_into': 'combined', 'archived': i == 2}} for i in range(3)]
+    monkeypatch.setattr(skill_ledger, 'list_entries', lambda: list(reversed(rows)))
+    assert history()['cursor'] == '2'
+    first = history('start', limit=2)
+    assert first['has_more'] and first['cursor'] == '1'
+    assert 'absorbed_into' not in first['events'][0]
+    assert history('1')['events'][0]['absorbed_into'] == 'combined'
+    assert history('missing')['cursor_found'] is False
+
+
+def test_corrupt_native_history_does_not_silently_skip_mutations(monkeypatch):
+    from tools import skill_ledger
+    from agent.learning_maintenance import history
+    monkeypatch.setattr(skill_ledger, '_read_ledger', lambda *a, **kw: b'{truncated')
+    assert history('last-good')['cursor_found'] is False
+
+
+def test_artifact_gc_preserves_current_referenced_and_recent_versions(tmp_path, monkeypatch):
+    from agent.learning_artifacts import fingerprint
+    from agent.learning_maintenance import prune_artifacts
+    from tools import skills_tool
+    monkeypatch.setattr(skills_tool, '_skill_catalog', lambda: [])
+    root = tmp_path/'learning/artifacts'
+    def snapshot(body, age):
+        version = fingerprint({'SKILL.md': hashlib.sha256(body.encode()).hexdigest()})
+        folder = root/version
+        folder.mkdir(parents=True)
+        (folder/'SKILL.md').write_text(body)
+        os.utime(folder, (time.time()-age, time.time()-age))
+        return version
+    old = snapshot('old', 40*86400)
+    protected = snapshot('referenced', 40*86400)
+    recent = snapshot('recent', 10)
+    preview = prune_artifacts(tmp_path, [protected])
+    assert preview['eligible'] == [old] and (root/old).exists()
+    result = prune_artifacts(tmp_path, [protected], dry_run=False)
+    assert result['removed'] == [old] and not (root/old).exists()
+    assert (root/protected).exists() and (root/recent).exists()
+
