+                        self.db.execute("UPDATE attempts SET payload=? WHERE id=?", (json.dumps(summary),attempt["id"]))
+                    self.db.execute("INSERT OR REPLACE INTO retired_scopes VALUES (?,?,?)", (row["id"],row["revision"],time.time()))
+                result["retired_scopes"] += 1
+            return result
