+"""Supported plugin-facing Learning API v1; all method results are serializable values."""
+from __future__ import annotations
+
+from pathlib import Path
+
+
+class LearningFacade:
+    __slots__ = ("_service",)
+    version = 1
+
+    def __init__(self, home: Path, plugin_id: str):
+        from agent.learning_service import LearningService
+        self._service = LearningService(home, plugin_id)
+
+    def open(self, source: dict) -> dict:
+        return self._service.open(source)
+
+    def observe(self, handle: str, observation: dict, *, event_id: str) -> dict:
+        return self._service.observe(handle, observation, event_id=event_id)
+
+    def run_review(self, handle: str, intent_id: str, *, attempt_id: str) -> dict:
+        return self._service.run_review(handle, intent_id, attempt_id=attempt_id)
+
+    def request_review(self, handle: str, *, request_id: str, messages: list[dict], focus: str = "",
+                       memory: bool = True, skills: bool = True, attended: bool = False) -> dict:
+        return self._service.request_review(handle, request_id=request_id, messages=messages,
+                                            focus=focus, memory=memory, skills=skills, attended=attended)
+
+    def cancel_request(self, request_id: str) -> dict:
+        return self._service.cancel_request(request_id)
+    def close_review_without_retry(self, handle: str, intent_id: str, *, attempt_id: str,
+                                  outcome_hash: str, artifact_versions: dict, note: str, evidence: str) -> dict:
+        return self._service.close_review_without_retry(handle, intent_id, attempt_id=attempt_id,
+            outcome_hash=outcome_hash, artifact_versions=artifact_versions, note=note, evidence=evidence)
+
+    def retry_review(self, handle: str, intent_id: str, *, failed_attempt_id: str,
+                     max_retries: int = 3) -> dict:
+        return self._service.retry_review(handle, intent_id, failed_attempt_id=failed_attempt_id,
+                                          max_retries=max_retries)
+
+    def read(self, *, kind: str, name: str | None = None, file_path: str | None = None,
+             issue_receipt: bool = True, detail: str = "full", artifact_version: str | None = None,
+             after_cursor: int = 0) -> dict:
+        return self._service.read(kind=kind, name=name, file_path=file_path, issue_receipt=issue_receipt,
+                                  detail=detail, artifact_version=artifact_version, after_cursor=after_cursor)
+
+    def prune(self, *, retention_seconds: float = 30 * 86400, dry_run: bool = True) -> dict:
+        return self._service.prune(retention_seconds=retention_seconds, dry_run=dry_run)
+
+    def record_usage(self, token: str, evidence: dict) -> dict:
+        return self._service.record_usage(token, evidence)
+
+    def prune_artifacts(self, protected_versions: list[str], *, retention_seconds: float = 30 * 86400,
+                        dry_run: bool = True) -> dict:
+        return self._service.prune_artifacts(protected_versions, retention_seconds=retention_seconds, dry_run=dry_run)
+
+    def configure_curator(self) -> dict:
+        return self._service.configure_curator()
+
+    def maintenance(self, *, handle: str | None = None, idle_flush: bool = False,
+                    host_idle_seconds: float | None = None) -> dict:
+        return self._service.maintenance(handle=handle, idle_flush=idle_flush, host_idle_seconds=host_idle_seconds)
+
+    def cancel(self) -> dict:
+        return self._service.cancel()
+
+    def close(self, *, handle: str | None = None, event_id: str | None = None) -> dict:
+        return self._service.close(handle=handle, event_id=event_id)
diff --git a/agent/learning_artifacts.py b/agent/learning_artifacts.py
new file mode 100644
index 00000000..afc6ede0
--- /dev/null
+++ b/agent/learning_artifacts.py
@@ -0,0 +1,115 @@
+"""Read native learning artifacts without recording catalog scans as skill use."""
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+import re
+from pathlib import Path
+
+
+def fingerprint(value) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+
+def context(home: Path) -> dict:
+    from tools.skills_tool import _skill_catalog
+    from agent.learning_graph import build_skill_nodes
+    nodes = build_skill_nodes([('profile', home / 'skills')])
+
+    memories = {}
+    for name in ("MEMORY.md", "USER.md"):
+        path = home / "memories" / name
+        memories[name] = path.read_text(encoding="utf-8-sig") if path.exists() else ""
+    skills = []
+    for entry in _skill_catalog():
+        if not entry["load_name"]:
+            continue
+        path = entry["path"]
+        signature = [(str(p.relative_to(path.parent)), p.stat().st_size, p.stat().st_mtime_ns)
+                     for p in sorted(path.parent.rglob("*")) if p.is_file()]
+        node = nodes.get(entry['load_name'])
+        skills.append({"name": entry["load_name"], "description": entry["description"],
+                       "version": fingerprint(signature),
+                       **({'related_skills': node.related, 'state': node.state, 'pinned': node.pinned,
+                           'use_count': node.use_count} if node else {})})
+    result = {"memories": memories, "skills": skills}
+    version = fingerprint(result)
+    summary = "\n".join(text for text in memories.values() if text)[:340]
+    if skills:
+        summary += "\n技能：" + "、".join(s["name"] for s in skills[:5])
+    return {**result, "version": version, "summary": summary}
+
+
+def skill(home: Path, name: str, file_path: str | None = None) -> dict:
+    from tools.skills_tool import skill_view
+
+    result = json.loads(skill_view(name, preprocess=False))
+    if not result.get("success"):
+        raise ValueError(result.get("error") or result.get("message") or "Skill is not loadable")
+    directory = Path(result["skill_dir"]).resolve()
+    files = {}
+    for path in sorted(directory.rglob("*")):
+        if not path.resolve().is_relative_to(directory):
+            raise ValueError("Skill resource escapes its package")
+        if path.is_file():
+            files[str(path.relative_to(directory))] = hashlib.sha256(path.read_bytes()).hexdigest()
+    version = fingerprint(files)
+    artifact = home / "learning" / "artifacts" / version
+    if not artifact.exists():
+        staging = artifact.with_suffix(".staging")
+        staging.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copytree(directory, staging, dirs_exist_ok=True)
+        copied = {str(p.relative_to(staging)): hashlib.sha256(p.read_bytes()).hexdigest()
+                  for p in staging.rglob("*") if p.is_file()}
+        if copied != files:
+            raise ValueError("Skill changed during publication; retry after its native write completes")
+        staging.rename(artifact)
+    relative = Path(file_path or "SKILL.md")
+    target = (artifact / relative).resolve()
+    if not target.is_relative_to(artifact.resolve()) or str(relative) not in files:
+        raise ValueError("Unknown skill resource")
+    raw = target.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != files[str(relative)]:
+        raise ValueError("Published skill resource was modified after publication")
+    try:
+        content = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        content = None
+    return {"name": result["name"], "version": version, "content": content,
+            "file_path": str(relative), "resource_dir": str(artifact), "files": files,
+            "content_hash": files[str(relative)],
+            **{k: result[k] for k in ("readiness_status", "compatibility", "deps_note") if k in result}}
+
+
+def snapshot(home: Path, name: str, version: str, file_path: str | None = None) -> dict:
+    import hermes_yaml as yaml
+    if not isinstance(version, str) or not re.fullmatch(r"[a-f0-9]{64}", version):
+        raise ValueError("Invalid artifact version")
+    root = home / "learning" / "artifacts" / version
+    if root.is_symlink() or not root.is_dir():
+        raise ValueError("Artifact snapshot is unavailable")
+    files = {}
+    for path in root.rglob("*"):
+        if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()):
+            raise ValueError("Artifact resource escapes its snapshot")
+        if path.is_file():
+            if path.stat().st_size > 2 * 1024 * 1024:
+                raise ValueError("Artifact resource is oversized")
+            files[str(path.relative_to(root))] = hashlib.sha256(path.read_bytes()).hexdigest()
+    if len(files) > 100 or fingerprint(files) != version or "SKILL.md" not in files:
+        raise ValueError("Artifact snapshot changed")
+    parts = (root / "SKILL.md").read_text().split("---", 2)
+    metadata = yaml.safe_load(parts[1]) if len(parts) == 3 else {}
+    if not isinstance(metadata, dict) or metadata.get("name") != name:
+        raise ValueError("Artifact snapshot belongs to a different skill")
+    relative = file_path or "SKILL.md"
+    if relative not in files:
+        raise ValueError("Unknown snapshot resource")
+    raw = (root / relative).read_bytes()
+    try:
+        content = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        content = None
+    return {"name":name,"version":version,"file_path":relative,"resource_dir":str(root),"files":files,
+            "content":content,"content_hash":files[relative],"readiness_status":"available"}
diff --git a/agent/learning_maintenance.py b/agent/learning_maintenance.py
new file mode 100644
index 00000000..212bc320
--- /dev/null
+++ b/agent/learning_maintenance.py
@@ -0,0 +1,141 @@
+"""Native maintenance and read-only lifecycle facts for external learning hosts.
+
+The host supplies idle time. All due, pin, archive, consolidation and backup
+decisions remain in the native Curator and skill tools.
+"""
+from __future__ import annotations
+
+import hashlib
+import copy
+import json
+import re
+import shutil
+import time
+from pathlib import Path
+
+
+def scheduled(idle_seconds):
+    from agent import curator
+
+    if not curator.should_run_now() or idle_seconds < curator.get_min_idle_hours() * 3600:
+        return {'curator': None, 'idle_seconds': idle_seconds}
+    if not curator._claim_run():
+        return {'curator': None, 'idle_seconds': idle_seconds}
+    try:
+        # The external host has one write owner. Its maintenance call must finish
+        # before the next review, publication or runtime drain can start.
+        result = curator.run_curator_review(synchronous=True, trigger='scheduled')
+        return {'curator': result, 'idle_seconds': idle_seconds}
+    finally:
+        curator._release_run_claim()
+
+
+def status():
+    from agent import curator, curator_backup
+    from hermes_cli.config import load_config_readonly
+    configuration = copy.deepcopy(load_config_readonly())
+    for key in ('enabled', 'consolidate'):
+        configuration.setdefault('curator', {}).pop(key, None)
+    scope_hash = hashlib.sha256(json.dumps(configuration, sort_keys=True, default=str).encode()).hexdigest()
+    state = curator.load_state()
+    return {'enabled': curator.is_enabled(), 'consolidate': curator.get_consolidate(),
+            'interval_hours': curator.get_interval_hours(), 'min_idle_hours': curator.get_min_idle_hours(),
+            'stale_after_days': curator.get_stale_after_days(), 'archive_after_days': curator.get_archive_after_days(),
+            'backup_keep': curator_backup.get_keep(), 'configuration_scope_hash': scope_hash,
+            'managed_skills': [row['name'] for row in curator.skill_usage.curated_report()
+                               if not curator.skill_usage.is_bundled(row['name'])], **state}
+
+
+def configure():
+    from hermes_cli.config import load_config_readonly, set_config_value
+    cfg = load_config_readonly().get('curator', {})
+    before = {'enabled': cfg.get('enabled', True), 'consolidate': cfg.get('consolidate', False)}
+    set_config_value('curator.enabled', 'true')
+    set_config_value('curator.consolidate', 'true')
+    return {'previous': before, 'enabled': True, 'consolidate': True}
+
+
+def history(cursor=None, limit=200):
+    from tools import skill_ledger
+    with skill_ledger._ledger_lock():
+        raw = skill_ledger._read_ledger('external lifecycle', quiet_missing=True)
+        if raw is None and skill_ledger.ledger_path().exists():
+            return {'events': [], 'cursor': cursor, 'cursor_found': False, 'has_more': False}
+        if raw:
+            try:
+                if any(not isinstance(json.loads(line), dict) for line in raw.decode('utf-8').splitlines() if line.strip()):
+                    raise ValueError('Invalid native history')
+            except (UnicodeError, ValueError):
+                return {'events': [], 'cursor': cursor, 'cursor_found': False, 'has_more': False}
+        rows = list(reversed(skill_ledger.list_entries()))
+    if cursor is None:
+        return {'events': [], 'cursor': rows[-1]['id'] if rows else 'start',
+                'cursor_found': True, 'has_more': False}
+    start = 0
+    if cursor != 'start':
+        match = next((i for i, row in enumerate(rows) if row.get('id') == cursor), None)
+        if match is None:
+            return {'events': [], 'cursor': cursor, 'cursor_found': False, 'has_more': False}
+        start = match + 1
+    selected = rows[start:start + limit]
+    events = []
+    for row in selected:
+        if not all(isinstance(row.get(key), str) for key in ('id', 'action', 'skill')):
+            raise ValueError('Malformed native skill lifecycle entry')
+        event = {key: row[key] for key in ('id', 'action', 'skill')}
+        evidence = row.get('evidence') or {}
+        target = evidence.get('absorbed_into')
+        if row['action'] == 'delete' and evidence.get('archived') is True and isinstance(target, str) and target:
+            event['absorbed_into'] = target
+        events.append(event)
+    return {'events': events, 'cursor': selected[-1]['id'] if selected else cursor,
+            'cursor_found': True, 'has_more': start + len(selected) < len(rows)}
+
+
+def prune_artifacts(home, protected_versions, *, retention_seconds=30 * 86400, dry_run=True):
+    from agent.learning_artifacts import fingerprint
+    from tools.skills_tool import _skill_catalog
+
+    if (not isinstance(dry_run, bool) or isinstance(retention_seconds, bool)
+            or not 30 * 86400 <= retention_seconds <= 3650 * 86400
+            or not isinstance(protected_versions, list)
+            or any(not isinstance(v, str) or not re.fullmatch(r'[a-f0-9]{64}', v) for v in protected_versions)):
+        raise ValueError('Invalid artifact retention request')
+    protected = set(protected_versions)
+    # Current native packages are authoritative, even if the host has not yet
+    # published them. Never generate snapshots just to compute a dry-run.
+    for entry in _skill_catalog():
+        directory = entry['path'].parent
+        files = {}
+        for path in directory.rglob('*'):
+            if path.is_symlink():
+                raise ValueError('Cannot establish current native artifact references')
+            if path.is_file():
+                files[str(path.relative_to(directory))] = hashlib.sha256(path.read_bytes()).hexdigest()
+        protected.add(fingerprint(files))
+    root = Path(home) / 'learning' / 'artifacts'
+    result = {'dry_run': dry_run, 'eligible': [], 'removed': [], 'protected': len(protected)}
+    cutoff = time.time() - retention_seconds
+    for path in sorted(root.iterdir()) if root.is_dir() else []:
+        if (path.is_symlink() or not path.is_dir() or not re.fullmatch(r'[a-f0-9]{64}', path.name)
+                or path.name in protected or path.stat().st_mtime >= cutoff):
+            continue
+        # A directory without a complete valid immutable package may be a
+        # interrupted publication or operator material; do not collect it.
+        files = {}
+        unsafe = False
+        for file in path.rglob('*'):
+            if file.is_symlink():
+                unsafe = True
+                break
+            if file.is_file():
+                files[str(file.relative_to(path))] = hashlib.sha256(file.read_bytes()).hexdigest()
+        if unsafe or 'SKILL.md' not in files or fingerprint(files) != path.name:
+            continue
+        result['eligible'].append(path.name)
+        if not dry_run:
+            shutil.rmtree(path)
+            result['removed'].append(path.name)
+        if len(result['eligible']) >= 100:
+            break
+    return result
