+"""Native root authentication is shared; external observation data stays in its profile."""
+import json
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.fixture
+def observed_profile(tmp_path, monkeypatch):
+    from hermes_cli.config import DEFAULT_CONFIG, atomic_config_write
+
+    account = tmp_path / "account"
+    root, home = account / ".hermes", tmp_path / "private-learning" / "observer"
+    root.mkdir(parents=True)
+    home.mkdir(parents=True)
+    alias = root / "profiles" / "observer"
+    alias.parent.mkdir()
+    alias.symlink_to(home, target_is_directory=True)
+    monkeypatch.setattr(Path, "home", lambda: account)
+    monkeypatch.setenv("HERMES_HOME", str(alias))
+    atomic_config_write(home / "config.yaml", {
+        "_config_version": DEFAULT_CONFIG["_config_version"],
+        "gateway": {"standalone": True},
+        "plugins": {"entries": {"fixture": {"settings": {"learning": {"enabled": True}}}}},
+    })
+    store = {"version": 1, "active_provider": "another-provider", "providers": {
+        "openai-codex": {"tokens": {"access_token": "fixture-old-at", "refresh_token": "fixture-old-rt"}}},
+        "credential_pool": {"openai-codex": [{"id": "root-row", "source": "device_code",
+            "auth_type": "oauth", "priority": 0, "access_token": "fixture-old-at", "refresh_token": "fixture-old-rt"}]}}
+    (root / "auth.json").write_text(json.dumps(store), encoding="utf-8")
+    return root, home, alias
+
+
+def test_profile_alias_reuses_and_rotates_one_native_auth_store(observed_profile):
+    from hermes_cli.auth import _save_codex_tokens, get_provider_auth_state, read_credential_pool
+    from hermes_cli.plugins_loader import _plugin_home_scope
+
+    root, home, _alias = observed_profile
+    with _plugin_home_scope(home):
+        assert get_provider_auth_state("openai-codex")["tokens"]["access_token"] == "fixture-old-at"
+        assert read_credential_pool("openai-codex")[0]["access_token"] == "fixture-old-at"
+        _save_codex_tokens({"access_token": "fixture-new-at", "refresh_token": "fixture-new-rt"},
+                           write_through=True)
+        assert get_provider_auth_state("openai-codex")["tokens"]["access_token"] == "fixture-new-at"
+    stored = json.loads((root / "auth.json").read_text(encoding="utf-8"))
+    assert stored["active_provider"] == "another-provider"
+    assert stored["providers"]["openai-codex"]["tokens"]["refresh_token"] == "fixture-new-rt"
+    assert stored["credential_pool"]["openai-codex"][0]["refresh_token"] == "fixture-new-rt"
+    assert not (home / "auth.json").exists()
+
+
+def test_shared_auth_does_not_share_artifacts_or_host_gateway(observed_profile):
+    from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+    from hermes_cli.profiles import profiles_to_serve
+
+    root, home, alias = observed_profile
+    for folder, text, name in ((root, "APP-PRIVATE-MEMORY", "app-only"), (home, "OBSERVER-MEMORY", "observer-only")):
+        (folder / "memories").mkdir()
+        (folder / "memories/MEMORY.md").write_text(text, encoding="utf-8")
+        skill = folder / "skills" / name
+        skill.mkdir(parents=True)
+        (skill / "SKILL.md").write_text(f"---\nname: {name}\ndescription: Fixture procedure.\n---\n{text}\n", encoding="utf-8")
+    ctx = PluginContext(PluginManifest(name="fixture", source="user"), PluginManager(scope_key=str(home)))
+    api = ctx.learning(version=1)
+    try:
+        api.open({"host": "fixture", "project": str(home), "chat": "chat"})
+        context = api.read(kind="context")
+        assert context["memories"]["MEMORY.md"] == "OBSERVER-MEMORY"
+        assert "observer-only" in {entry["name"] for entry in context["skills"]}
+        assert "app-only" not in {entry["name"] for entry in context["skills"]}
+        assert (home / "learning/journal.sqlite").exists()
+        assert not (root / "learning").exists()
+        assert (root / "memories/MEMORY.md").read_text(encoding="utf-8") == "APP-PRIVATE-MEMORY"
+        assert all(path != alias for _name, path in profiles_to_serve(multiplex=True))
+    finally:
+        api.close()
