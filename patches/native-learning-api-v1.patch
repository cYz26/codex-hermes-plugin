+"""Tool-item nudge policy shared by native Codex execution and observed execution."""
+
+
+def tick_skill_review(agent, completed_items: int) -> bool:
+    agent._iters_since_skill = getattr(agent, "_iters_since_skill", 0) + completed_items
+    due = (0 < agent._skill_nudge_interval <= agent._iters_since_skill
+           and "skill_manage" in agent.valid_tool_names)
+    if due:
+        agent._iters_since_skill = 0
+    return due
