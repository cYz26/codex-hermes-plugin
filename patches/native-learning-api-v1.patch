new file mode 100644
index 0000000..f9f2fe2
--- /dev/null
+++ b/agent/learning_results.py
@@ -0,0 +1,67 @@
+"""Machine-readable facts from native review tool results, independent of UI summaries."""
+from __future__ import annotations
+
+import json
+
+
+def changed_skill_name(fact: dict) -> str | None:
+    """Read both canonical facts and v1 receipts written before batch names were lifted."""
+    return fact.get("name") or fact.get("operation", {}).get("name")
+
+
+def _skill_batch_fact(fact: dict, operation: dict) -> dict:
+    return {**fact, "operation": operation,
+            "name": operation.get("name") or fact.get("name"),
+            "action": operation.get("action") or fact.get("action")}
+
+
+def review_outcome(state, error: str | None = None, *, prior_snapshot: list | None = None) -> dict:
+    prior_ids = {call["id"] for msg in prior_snapshot or [] for call in msg.get("tool_calls", []) or [] if call.get("id")}
+    calls = {}
+    for msg in state.review_messages:
+        for call in msg.get("tool_calls", []) or []:
+            fn = call.get("function", {})
+            if fn.get("name") in {"memory", "skill_manage"} and call.get("id") not in prior_ids:
+                try:
+                    calls[call["id"]] = (fn["name"], json.loads(fn.get("arguments", "{}")))
+                except (ValueError, KeyError):
+                    continue
+    outcome = {"applied": [], "staged": [], "refused": [], "uncertain": [],
+               "usage": state.review_usage or None, "error": error}
+    for msg in state.review_messages:
+        if msg.get("role") != "tool" or msg.get("tool_call_id") not in calls:
+            continue
+        tool, args = calls[msg["tool_call_id"]]
+        try:
+            data = json.loads(msg.get("content", "{}"))
+        except (ValueError, TypeError):
+            outcome["uncertain"].append({"tool": tool, "call_id": msg["tool_call_id"]})
+            continue
+        if not isinstance(data, dict):
+            outcome["uncertain"].append({"tool": tool, "call_id": msg["tool_call_id"]})
+            continue
+        fact = {"tool": tool, "action": args.get("action"), "name": args.get("name"),
+                "target": args.get("target"), "call_id": msg["tool_call_id"], "result": data}
+        if data.get("staged"):
+            outcome["staged"].append(fact)
+        elif data.get("success") is not True:
+            outcome["refused"].append(fact)
+        elif tool == "skill_manage" and "results" in data:
+            if data.get("operations_applied"):
+                outcome["applied"].extend(_skill_batch_fact(fact, item) for item in data["results"]
+                                          if isinstance(item, dict) and item.get("success") is True)
+        else:
+            outcome["applied"].append(fact)
+    result = state.result or {}
+    if error or result.get("failed") or result.get("error"):
+        outcome["run_status"] = "failed"
+        outcome["error"] = error or result.get("error")
+    elif result.get("interrupted"):
+        outcome["run_status"] = "interrupted"
+    elif result.get("completed") is True:
+        outcome["run_status"] = "completed"
+    else:
+        outcome["run_status"] = "unknown"
+    outcome["no_change"] = (outcome["run_status"] == "completed" and
+                            not any(outcome[k] for k in ("applied", "staged", "uncertain")))
+    return outcome
diff --git a/agent/learning_runtime.py b/agent/learning_runtime.py
new file mode 100644
index 0000000..4562ac0
--- /dev/null
+++ b/agent/learning_runtime.py
@@ -0,0 +1,143 @@
+"""Internal adapter to the native learning engine. No executor-specific transport here."""
+from __future__ import annotations
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+class NativeLearningRuntime:
+    def __init__(self):
+        self.agents = {}
+        self.db = None
+        self.recalled = {}
+
+    def agent(self, handle: str, source: dict):
+        if handle in self.agents:
+            return self.agents[handle]
+        from hermes_cli.config import load_config_readonly
+        from hermes_cli.runtime_provider import resolve_runtime_provider
+        from hermes_state import SessionDB
+        from run_agent import AIAgent
+        from hermes_constants import parse_reasoning_effort
+
+        cfg = load_config_readonly() or {}
+        model = cfg.get("model", {})
+        rt = resolve_runtime_provider(requested=model.get("provider"), target_model=model.get("default"),
+                                      explicit_base_url=model.get("base_url") or None)
+        self.db = self.db or SessionDB()
+        self.db.ensure_session(handle, source="external-observation", model=model.get("default"))
+        agent = AIAgent(
+            model=model.get("default", ""), provider=rt.get("provider"), api_mode=rt.get("api_mode"),
+            api_key=rt.get("api_key"), base_url=rt.get("base_url"), credential_pool=rt.get("credential_pool"),
+            request_overrides=rt.get("request_overrides"), session_id=handle, session_db=self.db,
+            reasoning_config=parse_reasoning_effort(cfg.get("agent", {}).get("reasoning_effort")),
+            cwd=source["project"], platform="external-observation", quiet_mode=True, skip_context_files=True,
+            ephemeral_system_prompt=("This scope observes tasks already executed by " + source.get("executor", "an external executor") +
+                                     ". Historical tool calls are external execution evidence. Learned procedures target that executor's observed tools and environment."),
+        )
+        self.agents[handle] = agent
+        return agent
+
+    def tick(self, handle: str, source: dict, memory_count: int, skill_count: int, *, new_turn: bool, tools: int) -> dict:
+        from agent.turn_context import _tick_memory_nudge
+        from agent.learning_policy import tick_skill_review
+
+        agent = self.agent(handle, source)
+        agent._turns_since_memory, agent._iters_since_skill = memory_count, skill_count
+        memory = _tick_memory_nudge(agent) if new_turn else False
+        skills = tick_skill_review(agent, tools)
+        return {"memory": memory, "skills": skills, "memory_count": agent._turns_since_memory,
+                "skill_count": agent._iters_since_skill}
+
+    def project(self, handle: str, source: dict, messages: list[dict], *, user: str, assistant: str, sync: bool) -> str:
+        agent = self.agent(handle, source)
+        # Stable message_uids make recovery of a committed observation's projection idempotent.
+        self.db.append_messages_batch(handle, messages)
+        if sync:
+            if agent._memory_manager and not getattr(agent, "_learning_provider_ready", False):
+                from agent.agent_init import _memory_provider_init_kwargs
+                agent._memory_manager.initialize_all(**_memory_provider_init_kwargs(agent, "external-observation"))
+                agent._learning_provider_ready = True
+            if agent._memory_manager:
+                self.recalled[handle] = agent._memory_manager.prefetch_all(user, session_id=handle)
+            agent._sync_external_memory_for_turn(original_user_message=user, final_response=assistant,
+                                                 interrupted=False, messages=messages)
+        if agent._cached_system_prompt is None:
+            stored = self.db.get_session(handle)
+            agent._cached_system_prompt = (stored or {}).get("system_prompt") or agent._build_system_prompt()
+            self.db.update_system_prompt(handle, agent._cached_system_prompt)
+        return "enqueued" if agent._memory_manager and agent._memory_manager._has_external else "not_configured"
+
+    def review(self, handle: str, source: dict, messages: list[dict], intent: dict) -> dict:
+        from agent import background_review as review
+        from agent.learning_results import review_outcome
+        from agent.thread_scoped_output import thread_scoped_silence
+
+        agent = self.agent(handle, source)
+        enabled, task = review.load_background_review_settings()
+        if not enabled:
+            return {"run_status": "deferred", "reason": "native_review_disabled"}
+        if not review._parent_can_emit_tool_calls(agent) and not review._resolve_review_runtime(agent, task).get("routed"):
+            return {"run_status": "deferred", "reason": "native_tools_unavailable"}
+        from run_agent import _review_should_defer
+        if _review_should_defer(agent, task):
+            from agent.review_idle_queue import _managed_server_idle
+            if not _managed_server_idle():
+                return {"run_status": "deferred", "reason": "native_local_model_busy"}
+        st, error = review._ReviewForkState(), None
+        prompt = getattr(agent, review._PROMPT_NAME_BY_SCOPE[(intent["memory"], intent["skills"])])
+        run = review.prepare_background_review_run(agent)
+        review._set_thread_approval_callback(review._bg_review_auto_deny)
+        try:
+            with thread_scoped_silence():
+                review._run_review_fork(agent, messages, prompt, task, run, st, intent["memory"], False)
+        except Exception as exc:
+            logger.exception("Native learning review failed")
+            error = f"{type(exc).__name__}: {exc}"
+        finally:
+            review.finish_background_review_run(agent, run)
+            if st.review_agent is not None:
+                review._release_fork_clients(st.review_agent)
+            review._set_thread_approval_callback(None)
+        return review_outcome(st, error, prior_snapshot=messages)
+
+    def maintenance(self, idle_seconds: float) -> dict:
+        from agent.curator import maybe_run_curator
+        result = maybe_run_curator(idle_for_seconds=idle_seconds)
+        return {"curator": result, "idle_seconds": idle_seconds}
+
+    def usage(self, handles: list[str]):
+        if handles and self.db is None:
+            from hermes_state import SessionDB
+            self.db = SessionDB()
+        return {handle: self.db.auxiliary_usage_by_task(handle) for handle in handles} if self.db else None
+
+    def cancel(self):
+        from agent.background_review import cancel_background_review_for_live_turn
+        for agent in self.agents.values():
+            cancel_background_review_for_live_turn(agent, message="learning owner stopping")
+
+    def close(self):
+        self.cancel()
+        drains = []
+        for agent in self.agents.values():
+            agent.shutdown_memory_provider(self.db.get_messages_as_conversation(agent.session_id))
+            if agent._memory_manager:
+                drains.append(agent._memory_manager.shutdown_drain_state())
+            agent.close()
+        if self.db:
+            self.db.close()
+        self.agents.clear()
+        return {"provider_drains": drains}
+
+    def close_scope(self, handle: str) -> dict:
+        agent = self.agents.pop(handle, None)
+        if agent is None:
+            return {"provider_drain": None}
+        messages = self.db.get_messages_as_conversation(handle)
+        agent.shutdown_memory_provider(messages)
+        drain = agent._memory_manager.shutdown_drain_state() if agent._memory_manager else None
+        agent.close()
+        self.recalled.pop(handle, None)
+        return {"provider_drain": drain}
diff --git a/agent/learning_service.py b/agent/learning_service.py
new file mode 100644
index 0000000..4ba54be
--- /dev/null
+++ b/agent/learning_service.py
@@ -0,0 +1,339 @@
+"""Learning API v1: profile-bound values, native execution, durable admission receipts.
+
+The learning journal owns admission/counters atomically. Native transcript projection is
+recoverable via deterministic message UIDs. Remote provider writes are explicitly not atomic
+with this journal: an interrupted projection is reported as uncertain, never blindly replayed.
+"""
+from __future__ import annotations
+
+import functools
+import json
+import logging
+import sqlite3
+import threading
+import time
+import uuid
+from pathlib import Path
+
+from agent.learning_artifacts import fingerprint
+from agent.learning_results import changed_skill_name
+
+logger = logging.getLogger(__name__)
+
+
+def _bound(method):
+    @functools.wraps(method)
+    def call(self, *args, **kwargs):
+        from hermes_cli.plugins_loader import _plugin_home_scope
+        with _plugin_home_scope(self.home):
+            return method(self, *args, **kwargs)
+    return call
+
+
+class LearningService:
+    version = 1
+
+    def __init__(self, home: Path, plugin_id: str):
+        from agent.learning_runtime import NativeLearningRuntime
+
+        self.home, self.plugin_id = Path(home).resolve(), plugin_id
+        root = self.home / "learning"
+        root.mkdir(exist_ok=True, mode=0o700)
+        # v1 has a single POSIX owner; plugin-host and multi-writer homes are unsupported.
+        import fcntl
+        self.owner = (root / "owner.lock").open("a+")
+        fcntl.flock(self.owner, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        self.lock = threading.RLock()
+        self.db = sqlite3.connect(root / "journal.sqlite", check_same_thread=False)
+        self.db.row_factory = sqlite3.Row
+        if self.db.execute("PRAGMA user_version").fetchone()[0] not in (0, 1):
+            self.db.close()
+            self.owner.close()
+            raise ValueError("Unsupported learning journal schema")
+        self.db.execute("PRAGMA journal_mode=WAL")
+        self.db.execute("PRAGMA synchronous=FULL")
+        self.db.executescript("""
+          CREATE TABLE IF NOT EXISTS scopes (id TEXT PRIMARY KEY, source TEXT NOT NULL,
+            revision INTEGER DEFAULT 0, reviewed INTEGER DEFAULT 0, memory_count INTEGER DEFAULT 0,
+            skill_count INTEGER DEFAULT 0, activity REAL NOT NULL);
+          CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            turn TEXT NOT NULL, revision INTEGER NOT NULL, body TEXT NOT NULL, messages TEXT NOT NULL,
+            projection TEXT NOT NULL DEFAULT 'pending', provider TEXT);
+          CREATE TABLE IF NOT EXISTS calls (handle TEXT, turn TEXT, call_id TEXT,
+            PRIMARY KEY(handle,turn,call_id));
+          CREATE TABLE IF NOT EXISTS receipts (id TEXT PRIMARY KEY, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS intents (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            revision INTEGER NOT NULL, status TEXT NOT NULL, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS attempts (id TEXT PRIMARY KEY, intent TEXT NOT NULL UNIQUE,
+            status TEXT NOT NULL, payload TEXT NOT NULL);
+          CREATE TABLE IF NOT EXISTS deliveries (token TEXT PRIMARY KEY, name TEXT NOT NULL,
+            version TEXT NOT NULL, status TEXT NOT NULL, evidence TEXT);
+          CREATE TABLE IF NOT EXISTS closures (id TEXT PRIMARY KEY, handle TEXT NOT NULL,
+            status TEXT NOT NULL, payload TEXT NOT NULL);
+        """)
+        with self.db:
+            self.db.execute("PRAGMA user_version=1")
+            self.db.execute("UPDATE attempts SET status='unknown' WHERE status='running'")
+            self.db.execute("UPDATE intents SET status='unknown' WHERE status='running'")
+            self.db.execute("UPDATE observations SET projection='uncertain' WHERE projection='projecting'")
+            self.db.execute("UPDATE closures SET status='unknown' WHERE status='closing'")
+        self.runtime = NativeLearningRuntime()
+        self.closed = False
+
+    def _scope(self, handle: str):
+        row = self.db.execute("SELECT * FROM scopes WHERE id=?", (handle,)).fetchone()
+        if row is None:
+            raise ValueError("Unknown learning handle")
+        return row
+
+    @_bound
+    def open(self, source: dict) -> dict:
+        identity_keys = {"host", "project", "chat"}
+        if not identity_keys <= set(source) or set(source) - identity_keys - {"executor"}:
+            raise ValueError("Unknown observation source fields")
+        if not all(isinstance(v, str) and v for v in source.values()):
+            raise ValueError("source requires host, absolute project and actual chat identity")
+        if len(source.get("executor", "")) > 80:
+            raise ValueError("executor label is too long")
+        if not Path(source["project"]).is_absolute():
+            raise ValueError("project must be absolute")
+        handle = "observed-" + fingerprint({k: source[k] for k in identity_keys})[:32]
+        with self.lock, self.db:
+            self.db.execute("INSERT OR IGNORE INTO scopes(id,source,activity) VALUES (?,?,?)",
+                            (handle, json.dumps(source), time.time()))
+        return {"handle": handle, "version": 1}
+
+    def _messages(self, body: dict, identity: str, new_turn: bool, known_calls: set) -> list[dict]:
+        messages = [{"role": "user", "content": body["user"] if new_turn else
+                     "[Supplemental external execution evidence for the prior turn; not a new user request.]"}]
+        for tool in body.get("tools", []):
+            if tool["call_id"] in known_calls or tool["status"] != "completed":
+                continue
+            call_id = "external-" + fingerprint([body["source"], tool["call_id"]])[:32]
+            messages.extend([
+                {"role": "assistant", "content": None, "tool_calls": [{"id": call_id, "type": "function",
+                  "function": {"name": tool["name"], "arguments": json.dumps(tool.get("arguments", {}))}}]},
+                {"role": "tool", "tool_call_id": call_id, "tool_name": tool["name"],
+                 "content": tool["result"] if isinstance(tool["result"], str) else json.dumps(tool["result"], ensure_ascii=False)},
+            ])
+        if body.get("assistant"):
+            messages.append({"role": "assistant", "content": body["assistant"]})
+        for index, msg in enumerate(messages):
+            msg.update(message_uid=fingerprint([identity, index]), observed=True)
+        return messages
+
+    @_bound
+    def observe(self, handle: str, observation: dict, *, event_id: str) -> dict:
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT payload FROM receipts WHERE id=?", (event_id,)).fetchone()
+            body_hash = fingerprint(observation)
+            if previous:
+                receipt = json.loads(previous[0])
+                if receipt["content_hash"] != body_hash or receipt["handle"] != handle:
+                    raise ValueError("Observation identity conflict")
+                return receipt
+            scope = self._scope(handle)
+            body = observation
+            expected = json.loads(scope["source"])
+            if any(body["source"][k] != expected[k] for k in ("host", "project", "chat")):
+                raise ValueError("Observation scope mismatch")
+            if body.get("status") not in {"completed", "interrupted"} or not isinstance(body.get("user"), str):
+                raise ValueError("Only terminal observed turns are accepted")
+            turn = body["source"]["turn"]
+            same = self.db.execute("SELECT id FROM observations WHERE handle=? AND turn=? AND body=?",
+                                   (handle, turn, json.dumps(body, sort_keys=True))).fetchone()
+            if same:
+                receipt = json.loads(self.db.execute("SELECT payload FROM receipts WHERE id=?", (same[0],)).fetchone()[0])
+                receipt = {**receipt, "id": event_id, "duplicate_of": same[0]}
+                self.db.execute("INSERT INTO receipts VALUES (?,?)", (event_id, json.dumps(receipt)))
+                return receipt
+            new_turn = not self.db.execute("SELECT 1 FROM observations WHERE handle=? AND turn=?", (handle, turn)).fetchone()
+            known = {r[0] for r in self.db.execute("SELECT call_id FROM calls WHERE handle=? AND turn=?", (handle, turn))}
+            messages = self._messages(body, event_id, new_turn, known)
+            calls = {t["call_id"] for t in body.get("tools", []) if t["status"] == "completed"} - known
+            ticks = self.runtime.tick(handle, json.loads(scope["source"]), scope["memory_count"], scope["skill_count"],
+                                      new_turn=new_turn, tools=len(calls))
+            revision = scope["revision"] + 1
+            self.db.execute("INSERT INTO observations(id,handle,turn,revision,body,messages) VALUES (?,?,?,?,?,?)",
+                            (event_id, handle, turn, revision, json.dumps(body, sort_keys=True), json.dumps(messages)))
+            self.db.executemany("INSERT INTO calls VALUES (?,?,?)", [(handle, turn, call) for call in calls])
+            self.db.execute("UPDATE scopes SET revision=?,memory_count=?,skill_count=?,activity=? WHERE id=?",
+                            (revision, ticks["memory_count"], ticks["skill_count"], time.time(), handle))
+            intent = None
+            if body["status"] == "completed" and body.get("assistant") and (ticks["memory"] or ticks["skills"]):
+                intent = self._intent(handle, revision, ticks["memory"], ticks["skills"], "native_threshold")
+            receipt = {"id": event_id, "handle": handle, "revision": revision, "content_hash": body_hash,
+                       "new_user_turn": new_turn, "completed_tool_delta": len(calls), "intent": intent,
+                       "coverage": body.get("coverage", []),
+                       "count_confidence": "observed_only" if body.get("coverage") else "source_ids"}
+            self.db.execute("INSERT INTO receipts VALUES (?,?)", (event_id, json.dumps(receipt)))
+        self._project(event_id)
+        return receipt
+
+    def _intent(self, handle, revision, memory, skills, reason):
+        identity = fingerprint([handle, revision, reason])
+        value = {"id": identity, "handle": handle, "revision": revision, "memory": memory, "skills": skills, "reason": reason}
+        self.db.execute("INSERT OR IGNORE INTO intents VALUES (?,?,?,'queued',?)",
+                        (identity, handle, revision, json.dumps(value)))
+        return identity
+
+    def _project(self, identity):
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM observations WHERE id=?", (identity,)).fetchone()
+            if row["projection"] != "pending":
+                return
+            self.db.execute("UPDATE observations SET projection='projecting' WHERE id=?", (identity,))
+        body = json.loads(row["body"])
+        provider = self.runtime.project(row["handle"], json.loads(self._scope(row["handle"])["source"]), json.loads(row["messages"]),
+                                        user=body["user"], assistant=body.get("assistant", ""), sync=body["status"] == "completed")
+        with self.lock, self.db:
+            self.db.execute("UPDATE observations SET projection='projected',provider=? WHERE id=?", (provider, identity))
+
+    @_bound
+    def run_review(self, handle: str, intent_id: str, *, attempt_id: str) -> dict:
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT * FROM attempts WHERE intent=? OR id=?", (intent_id, attempt_id)).fetchone()
+            if previous:
+                if previous["intent"] != intent_id:
+                    raise ValueError("Attempt identity conflict")
+                return {**json.loads(previous["payload"]), "run_status": previous["status"]}
+            row = self.db.execute("SELECT * FROM intents WHERE id=? AND handle=?", (intent_id, handle)).fetchone()
+            if row is None or row["status"] != "queued":
+                raise ValueError("Review intent is not queued for this scope")
+            if self.db.execute("SELECT 1 FROM attempts WHERE status='running'").fetchone():
+                return {"run_status": "deferred", "reason": "another_review_running"}
+            if self.db.execute("SELECT 1 FROM observations WHERE handle=? AND revision<=? AND projection!='projected'",
+                               (handle, row["revision"])).fetchone():
+                return {"run_status": "deferred", "reason": "projection_incomplete"}
+            intent = json.loads(row["payload"])
+            scope = self._scope(handle)
+            if row["revision"] <= scope["reviewed"]:
+                self.db.execute("UPDATE intents SET status='superseded' WHERE id=?", (intent_id,))
+                return {"run_status": "superseded"}
+            self.db.execute("INSERT INTO attempts VALUES (?,?,'running',?)", (attempt_id, intent_id, json.dumps({"id": attempt_id})))
+            self.db.execute("UPDATE intents SET status='running' WHERE id=?", (intent_id,))
+            messages = [m for r in self.db.execute("SELECT messages FROM observations WHERE handle=? AND revision<=? ORDER BY revision",
+                                                   (handle, row["revision"])) for m in json.loads(r[0])]
+        try:
+            outcome = self.runtime.review(handle, json.loads(scope["source"]), messages, intent)
+        except Exception as exc:
+            logger.exception("Learning review attempt failed")
+            outcome = {"run_status": "unknown", "error": f"{type(exc).__name__}: {exc}", "uncertain": ["executor raised"]}
+        with self.lock, self.db:
+            state = outcome["run_status"]
+            if state == "deferred":
+                self.db.execute("DELETE FROM attempts WHERE id=?", (attempt_id,))
+                self.db.execute("UPDATE intents SET status='queued' WHERE id=?", (intent_id,))
+            else:
+                self.db.execute("UPDATE attempts SET status=?,payload=? WHERE id=?", (state, json.dumps(outcome), attempt_id))
+                self.db.execute("UPDATE intents SET status=? WHERE id=?", (state, intent_id))
+                if state == "completed":
+                    self.db.execute("UPDATE scopes SET reviewed=MAX(reviewed,?) WHERE id=?", (row["revision"], handle))
+        return {**outcome, "id": attempt_id, "intent_id": intent_id}
+
+    @_bound
+    def read(self, *, kind: str, name: str | None = None, file_path: str | None = None) -> dict:
+        if kind == "context":
+            from agent.learning_artifacts import context
+            value = context(self.home)
+            recalled = "\n".join(getattr(self.runtime, "recalled", {}).values())
+            value["provider_recall"] = recalled
+            recent = []
+            with self.lock:
+                for row in self.db.execute("SELECT payload FROM attempts WHERE status='completed' ORDER BY rowid DESC LIMIT 3"):
+                    for fact in json.loads(row[0]).get("applied", []):
+                        name = changed_skill_name(fact)
+                        if name and name not in recent:
+                            recent.append(name)
+            if recent:
+                memory = "\n".join(value["memories"].values())[:340]
+                value["summary"] = memory + "\n新更新技能：" + "、".join(recent[:5])
+            if recalled:
+                value["summary"] += "\n" + recalled[:180]
+            value["version"] = fingerprint([value["version"], recalled])
+            return value
+        if kind == "skill":
+            from agent.learning_artifacts import skill
+            value = skill(self.home, name, file_path)
+            token = uuid.uuid4().hex
+            with self.lock, self.db:
+                self.db.execute("INSERT INTO deliveries VALUES (?,?,?,'issued',NULL)", (token, value["name"], value["version"]))
+            return {**value, "delivery_token": token}
+        if kind == "status":
+            with self.lock:
+                intents = [{**json.loads(r["payload"]), "status": r["status"]} for r in self.db.execute("SELECT * FROM intents")]
+                attempts = [{**json.loads(r["payload"]), "id": r["id"], "run_status": r["status"]} for r in self.db.execute("SELECT * FROM attempts")]
+                gaps = [dict(r) for r in self.db.execute("SELECT id,projection,provider FROM observations WHERE projection!='projected'")]
+                handles = [r[0] for r in self.db.execute("SELECT id FROM scopes")]
+                closures = [{"id": r["id"], "handle": r["handle"], "status": r["status"], **json.loads(r["payload"])}
+                            for r in self.db.execute("SELECT * FROM closures")]
+            return {"version": 1, "intents": intents, "attempts": attempts, "projection_gaps": gaps, "closures": closures,
+                    "usage": {"source_execution": None, "native_auxiliary_by_session": self.runtime.usage(handles),
+                              "external_provider_usage": None, "attempt_usage_overlaps_native_ledger": True}}
+        raise ValueError("Unknown read request")
+
+    @_bound
+    def record_usage(self, token: str, evidence: dict) -> dict:
+        from tools.skill_usage import bump_use, bump_view
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM deliveries WHERE token=?", (token,)).fetchone()
+            if row is None:
+                raise ValueError("Unknown skill delivery")
+            if row["status"] != "issued":
+                return {"recorded": False, "status": row["status"]}
+            if evidence.get("stage") != "body_delivered" or not evidence.get("source_event"):
+                raise ValueError("Usage requires a confirmed body delivery source")
+            self.db.execute("UPDATE deliveries SET status='applying',evidence=? WHERE token=?", (json.dumps(evidence), token))
+        bump_view(row["name"])
+        bump_use(row["name"], task_id=str(evidence["source_event"]))
+        with self.lock, self.db:
+            self.db.execute("UPDATE deliveries SET status='recorded' WHERE token=?", (token,))
+        return {"recorded": True, "native_telemetry": "best_effort"}
+
+    @_bound
+    def maintenance(self, *, handle: str | None = None, idle_flush: bool = False) -> dict:
+        with self.lock, self.db:
+            for row in self.db.execute("SELECT id FROM observations WHERE projection='pending'").fetchall():
+                self._project(row[0])
+            intent = None
+            if idle_flush:
+                scope = self._scope(handle)
+                pending = self.db.execute("SELECT 1 FROM intents WHERE handle=? AND status IN ('queued','running','unknown')", (handle,)).fetchone()
+                attempted = self.db.execute("SELECT 1 FROM intents WHERE handle=? AND revision>=? AND status IN ('completed','failed','interrupted')",
+                                            (handle, scope["revision"])).fetchone()
+                if scope["revision"] > scope["reviewed"] and not pending and not attempted:
+                    intent = self._intent(handle, scope["revision"], True, True, "idle_flush")
+            last = self.db.execute("SELECT MAX(activity) FROM scopes").fetchone()[0]
+        return {"intent": intent, **self.runtime.maintenance(max(0, time.time() - (last or time.time())))}
+
+    @_bound
+    def cancel(self) -> dict:
+        self.runtime.cancel()
+        return {"requested": True, "rollback": False}
+
+    @_bound
+    def close(self, *, handle: str | None = None, event_id: str | None = None) -> dict:
+        if handle is not None:
+            return self._close_scope(handle, event_id)
+        if self.closed:
+            return {"closed": True}
+        result = self.runtime.close()
+        self.db.close()
+        self.owner.close()
+        self.closed = True
+        return result
+
+    def _close_scope(self, handle, event_id):
+        if not event_id:
+            raise ValueError("A real session-end event id is required")
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT status,payload FROM closures WHERE id=?", (event_id,)).fetchone()
+            if previous:
+                return {"status": previous["status"], **json.loads(previous["payload"])}
+            if self.db.execute("SELECT 1 FROM intents WHERE handle=? AND status IN ('queued','running')", (handle,)).fetchone():
+                return {"status": "deferred"}
+            self.db.execute("INSERT INTO closures VALUES (?,?,'closing','{}')", (event_id, handle))
+        result = self.runtime.close_scope(handle)
+        with self.lock, self.db:
+            self.db.execute("UPDATE closures SET status='closed',payload=? WHERE id=?", (json.dumps(result), event_id))
+        return {"status": "closed", **result}
