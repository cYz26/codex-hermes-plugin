@@ -0,0 +1,37 @@
+"""Supported plugin-facing Learning API v1; all method results are serializable values."""
+from __future__ import annotations
+
+from pathlib import Path
+
+
+class LearningFacade:
+    __slots__ = ("_service",)
+    version = 1
+
+    def __init__(self, home: Path, plugin_id: str):
+        from agent.learning_service import LearningService
+        self._service = LearningService(home, plugin_id)
+
+    def open(self, source: dict) -> dict:
+        return self._service.open(source)
+
+    def observe(self, handle: str, observation: dict, *, event_id: str) -> dict:
+        return self._service.observe(handle, observation, event_id=event_id)
+
+    def run_review(self, handle: str, intent_id: str, *, attempt_id: str) -> dict:
+        return self._service.run_review(handle, intent_id, attempt_id=attempt_id)
+
+    def read(self, *, kind: str, name: str | None = None, file_path: str | None = None) -> dict:
+        return self._service.read(kind=kind, name=name, file_path=file_path)
+
+    def record_usage(self, token: str, evidence: dict) -> dict:
+        return self._service.record_usage(token, evidence)
+
+    def maintenance(self, *, handle: str | None = None, idle_flush: bool = False) -> dict:
+        return self._service.maintenance(handle=handle, idle_flush=idle_flush)
+
+    def cancel(self) -> dict:
+        return self._service.cancel()
+
+    def close(self, *, handle: str | None = None, event_id: str | None = None) -> dict:
+        return self._service.close(handle=handle, event_id=event_id)
diff --git a/agent/learning_artifacts.py b/agent/learning_artifacts.py
new file mode 100644
index 0000000..5dc3229
--- /dev/null
+++ b/agent/learning_artifacts.py
@@ -0,0 +1,76 @@
+"""Read native learning artifacts without recording catalog scans as skill use."""
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+from pathlib import Path
+
+
+def fingerprint(value) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+
+def context(home: Path) -> dict:
+    from tools.skills_tool import _skill_catalog
+
+    memories = {}
+    for name in ("MEMORY.md", "USER.md"):
+        path = home / "memories" / name
+        memories[name] = path.read_text(encoding="utf-8-sig") if path.exists() else ""
+    skills = []
+    for entry in _skill_catalog():
+        if not entry["load_name"]:
+            continue
+        path = entry["path"]
+        signature = [(str(p.relative_to(path.parent)), p.stat().st_size, p.stat().st_mtime_ns)
+                     for p in sorted(path.parent.rglob("*")) if p.is_file()]
+        skills.append({"name": entry["load_name"], "description": entry["description"],
+                       "version": fingerprint(signature)})
+    result = {"memories": memories, "skills": skills}
+    version = fingerprint(result)
+    summary = "\n".join(text for text in memories.values() if text)[:340]
+    if skills:
+        summary += "\n技能：" + "、".join(s["name"] for s in skills[:5])
+    return {**result, "version": version, "summary": summary}
+
+
+def skill(home: Path, name: str, file_path: str | None = None) -> dict:
+    from tools.skills_tool import skill_view
+
+    result = json.loads(skill_view(name, preprocess=False))
+    if not result.get("success"):
+        raise ValueError(result.get("error") or result.get("message") or "Skill is not loadable")
+    directory = Path(result["skill_dir"]).resolve()
+    files = {}
+    for path in sorted(directory.rglob("*")):
+        if not path.resolve().is_relative_to(directory):
+            raise ValueError("Skill resource escapes its package")
+        if path.is_file():
+            files[str(path.relative_to(directory))] = hashlib.sha256(path.read_bytes()).hexdigest()
+    version = fingerprint(files)
+    artifact = home / "learning" / "artifacts" / version
+    if not artifact.exists():
+        staging = artifact.with_suffix(".staging")
+        staging.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copytree(directory, staging, dirs_exist_ok=True)
+        copied = {str(p.relative_to(staging)): hashlib.sha256(p.read_bytes()).hexdigest()
+                  for p in staging.rglob("*") if p.is_file()}
+        if copied != files:
+            raise ValueError("Skill changed during publication; retry after its native write completes")
+        staging.rename(artifact)
+    relative = Path(file_path or "SKILL.md")
+    target = (artifact / relative).resolve()
+    if not target.is_relative_to(artifact.resolve()) or str(relative) not in files:
+        raise ValueError("Unknown skill resource")
+    raw = target.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != files[str(relative)]:
+        raise ValueError("Published skill resource was modified after publication")
+    try:
+        content = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        content = None
+    return {"name": result["name"], "version": version, "content": content,
+            "file_path": str(relative), "resource_dir": str(artifact), "files": files,
+            "content_hash": files[str(relative)],
+            **{k: result[k] for k in ("readiness_status", "compatibility", "deps_note") if k in result}}
