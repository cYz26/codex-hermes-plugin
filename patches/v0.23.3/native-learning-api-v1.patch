+"""Client of the local, single-owner Hermes learning service."""
+from __future__ import annotations
+
+from contextlib import closing, contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import socket
+import sqlite3
+import time
+import uuid
+
+from hermes_constants import get_hermes_home
+
+logger = logging.getLogger(__name__)
+
+PROTOCOL = 1
+MARKER = "shared-learning-client.json"
+OUTBOX = "shared-learning-outbox.sqlite"
+LOCAL_SURFACES = {"cli", "tui", "gui", "desktop"}
+HOOKS = {"pre_tool_call", "post_tool_call", "post_llm_call", "on_session_end"}
+_ACTIVE = ContextVar("native_shared_learning_turn", default=None)
+_MANAGEMENT = ContextVar("native_shared_learning_management", default=None)
+
+
+class Unavailable(RuntimeError):
+    pass
+
+
+class Refused(RuntimeError):
+    def __init__(self, message, *, permanent=False):
+        super().__init__(message)
+        self.permanent = permanent
+
+
+def binding(home=None):
+    home = (home or get_hermes_home()).resolve()
+    marker = home / MARKER
+    if not marker.exists():
+        return None
+    if marker.is_symlink() or marker.stat().st_uid != os.getuid() or marker.stat().st_mode & 0o077:
+        raise Refused("Shared learning client configuration must be private")
+    cfg = json.loads(marker.read_text())
+    if (cfg["version"] != PROTOCOL or Path(cfg["profile"]).resolve() != home
+            or not Path(cfg["socket"]).is_absolute()):
+        raise Refused("Shared learning client configuration needs a compatible owner")
+    return Client(home, cfg["socket"], cfg["client_id"])
+
+
+def _json(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _identifier(value):
+    return hashlib.sha256(_json(value).encode()).hexdigest()
+
+
+@dataclass(frozen=True)
+class Client:
+    home: Path
+    socket_path: str
+    client_id: str = field(repr=False)
+
+    def call(self, method, params, *, timeout=0.4):
+        request = {"method": "shared_" + method,
+                   "params": {**params, "version": PROTOCOL, "client": self.client_id}}
+        try:
+            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
+                sock.settimeout(timeout)
+                sock.connect(self.socket_path)
+                sock.sendall((_json(request) + "\n").encode())
+                with sock.makefile("rb") as stream:
+                    reply = json.loads(stream.readline(4 * 1024 * 1024))
+        except (OSError, ValueError) as exc:
+            raise Unavailable("The shared learning service is unavailable") from exc
+        if "error" in reply:
+            raise Refused(reply["error"], permanent=reply.get("permanent") is True)
+        result = reply["result"]
+        if result.get("available") is False:
+            raise Unavailable("The shared learning service is unavailable")
+        return result
+
+    def db(self):
+        path = self.home / OUTBOX
+        if path.is_symlink():
+            raise PermissionError("Shared learning outbox must not be symlinked")
+        fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+        try:
+            st = os.fstat(fd)
+            if st.st_uid != os.getuid() or st.st_mode & 0o077:
+                raise PermissionError("Shared learning outbox must be private")
+        finally:
+            os.close(fd)
+        db = sqlite3.connect(path, timeout=0.5)
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute("CREATE TABLE IF NOT EXISTS outbox (id TEXT PRIMARY KEY, method TEXT, params TEXT)")
+        return db
+
+    def queue(self, method, params):
+        encoded = _json(params)
+        if len(encoded.encode()) > 256 * 1024:
+            raise Refused("Shared learning message exceeds the local transport limit")
+        key = _identifier([method, params])
+        with closing(self.db()) as db, db:
+            db.execute("INSERT OR IGNORE INTO outbox VALUES (?,?,?)", (key, method, encoded))
+        return key
+
+    def flush(self, deliver=None, *, limit=25, request=None):
+        """Keep causal order. If an acknowledgement is lost, the owner de-duplicates the retry."""
+        with closing(self.db()) as db:
+            pending = db.execute("SELECT * FROM outbox ORDER BY rowid LIMIT ?", (limit,)).fetchall()
+            for id_, method, raw in pending:
+                params = json.loads(raw)
+                try:
+                    if deliver is None:
+                        result = self.call(method, params, timeout=0.25)
+                    else:
+                        result = deliver(method, {**params, "version": PROTOCOL, "client": self.client_id})
+                except Unavailable:
+                    break
+                except Refused as exc:
+                    if not exc.permanent:
+                        break
+                    result = {"state": "failed", "result": {"error": str(exc)}}
+                    with db:
+                        db.execute("CREATE TABLE IF NOT EXISTS withheld (id TEXT PRIMARY KEY, reason TEXT)")
+                        db.execute("INSERT OR IGNORE INTO withheld VALUES (?,?)", (id_, type(exc).__name__))
+                if (result or {}).get("state") == "awaiting_prompt":
+                    continue
+                with db:
+                    db.execute("DELETE FROM outbox WHERE id=?", (id_,))
+                if id_ == request:
+                    return result
+        return None
+
+
+def _cwd(agent=None, *, cli=False):
+    from agent.runtime_cwd import scoped_session_cwd
+
+    value = scoped_session_cwd() or (getattr(agent, "session_cwd", None) if agent is not None else None)
+    if not value and cli:
+        value = os.getcwd()
+    if value and Path(value).is_absolute():
+        path = Path(value).resolve()
+        home = get_hermes_home().resolve()
+        if path.is_dir() and path != Path.home().resolve() and not path.is_relative_to(home):
+            return str(path)
+    return None
+
+
+@dataclass
+class Access:
+    client: Client
+    surface: str
+    cwd: str | None
+    session: str | None = None
+    turn: str | None = None
+    user_started: bool = False
+    response: object = ""
+    moved: bool = False
+    read_versions: dict = field(default_factory=dict)
+    deliveries: dict = field(default_factory=dict)
+
+    @property
+    def params(self):
+        return {"surface": self.surface, "cwd": self.cwd, "session": self.session, "turn": self.turn}
+
+    def read(self, method, **args):
+        if self.moved:
+            raise Refused("Start a new Hermes session in the new workspace to access shared learning")
+        return self.client.call(method, {**self.params, **args})
+
+    def event(self, kind, **args):
+        if not self.moved and self.session and self.turn:
+            self.client.queue("event", {**self.params, **args, "kind": kind})
+
+    def write(self, operation, args, base=None, request_id=None):
+        if self.moved:
+            raise Refused("Start a new Hermes session after changing workspace")
+        request_id = request_id or uuid.uuid4().hex
+        from agent.memory_manager import _redact_for_provider
+        if _redact_for_provider(args) != args:
+            raise Refused("Shared knowledge contains private credentials")
+        params = {**self.params, "operation": operation, "args": args, "base": base, "request_id": request_id}
+        key = self.client.queue("write", params)
+        ack = self.client.flush(limit=50, request=key)
+        if ack and ack["state"] not in {"queued", "applying", "unknown"}:
+            return {**ack, "request_id": request_id}
+        try:
+            deadline = time.monotonic() + 2
+            while time.monotonic() < deadline:
+                receipt = self.read("receipt", request_id=request_id)
+                if receipt["state"] not in {"queued", "applying", "unknown"}:
+                    return receipt
+                time.sleep(0.08)
+        except Unavailable:
+            pass
+        return {"state": "queued", "request_id": request_id}
+
+
+def active():
+    return _ACTIVE.get()
+
+
+def management(*, surface="cli", cwd=None):
+    running = active() or _MANAGEMENT.get()
+    if running is not None:
+        return running
+    if surface not in LOCAL_SURFACES:
+        return None
+    client = binding()
+    if client is None:
+        return None
+    selected = cwd or _cwd(cli=surface == "cli")
+    if selected is None and surface in {"gui", "desktop"}:
+        selected = os.environ.get("HERMES_SHARED_LEARNING_MANAGEMENT_CWD")
+    return Access(client, surface, selected)
+
+
+@contextmanager
+def management_scope(*, surface, cwd=None):
+    token = _MANAGEMENT.set(management(surface=surface, cwd=cwd))
+    try:
+        yield
+    finally:
+        _MANAGEMENT.reset(token)
+
+
+def prepare_agent(agent, platform):
+    """A client binds only a regular local execution session. It never opens the owner home."""
+    platform = str(getattr(platform, "value", platform) or "").lower()
+    if (platform not in LOCAL_SURFACES or getattr(agent, "_persist_disabled", False)
+            or getattr(agent, "memory_agent_context", None) in {"subagent", "cron"}
+            or getattr(agent, "_parent_session_id", None)):
+        return None
+    client = binding()
+    if client is None:
+        return None
+    access = Access(client, platform, _cwd(agent, cli=platform == "cli"), getattr(agent, "session_id", None))
+    agent._shared_learning = access
+    return access
+
+
+@contextmanager
+def turn_scope(agent):
+    configured = getattr(agent, "_shared_learning", None)
+    if configured is None:
+        yield
+        return
+    access = Access(configured.client, configured.surface, configured.cwd,
+                    session=getattr(agent, "session_id", None), read_versions=configured.read_versions,
+                    deliveries=configured.deliveries,
+                    moved=_cwd(agent, cli=configured.surface == "cli") != configured.cwd)
+    token = _ACTIVE.set(access)
+    try:
+        yield
+    finally:
+        _ACTIVE.reset(token)
+
+
+def _clip(value, limit):
+    if isinstance(value, str):
+        # Use Hermes' native secret scrub before writing the client outbox.
+        from agent.memory_manager import _scrub
+        import re
+        return _scrub(re.sub(r"data:[^,\s]+;base64,[A-Za-z0-9+/=_-]+", "[Attachment omitted]", value[:limit]))
+    if isinstance(value, list):
+        return [_clip(item["text"], limit) for item in value[:6] if isinstance(item, dict) and isinstance(item.get("text"), str)]
+    return ""
+
+
+def begin(turn, user):
+    access = active()
+    if access is None or access.moved or not turn:
+        return
+    access.turn = turn
+    access.user_started = True
+    text = _clip(user, 12288)
+    access.event("prompt", text=text if isinstance(text, str) else "\n".join(text))
+
+
+def observe(hook, **values):
+    access = active()
+    if not access or not access.user_started or values.get("turn_id") != access.turn or hook not in HOOKS:
+        return
+    if hook == "post_llm_call":
+        access.response = _clip(values.get("assistant_response"), 12288)
+    elif hook == "on_session_end":
+        if values.get("completed") or values.get("failed") or values.get("interrupted"):
+            kind = "finished" if values.get("completed") and not values.get("interrupted") else "interrupted"
+            access.event(kind, text=access.response)
+        access.user_started = False
+        access.client.flush()
+    else:
+        tool, call = values.get("tool_name"), values.get("tool_call_id")
+        if not tool or not call:
+            return
+        if tool in {"memory", "skills_list", "skill_manage", "session_search", "shared_learning_feedback"}:
+            return
+        if tool == "skill_view" and hook != "post_tool_call":
+            return
+        args = values.get("args")
+        if not isinstance(args, dict):
+            args = {}
+        from agent.memory_manager import _redact_for_provider
+        args = _redact_for_provider(args)
+        if len(_json(args).encode()) > 8192:
+            args = {}
+        if hook == "pre_tool_call":
+            access.event("tool_start", tool=tool, call=call, args=args)
+        else:
+            result = values.get("result")
+            if tool == "skill_view":
+                try:
+                    value = json.loads(result) if isinstance(result, str) else result
+                    result = {k: value[k] for k in ("name", "version", "delivery_token") if k in value}
+                    if result.get("delivery_token"):
+                        access.deliveries[result["name"]] = result["delivery_token"]
+                except (TypeError, KeyError, ValueError):
+                    result = {}
+            else:
+                if isinstance(result, str):
+                    try:
+                        result = json.loads(result)
+                    except ValueError:
+                        pass
+                result = _clip(result, 8192) if not isinstance(result, dict) else _redact_for_provider(result)
+                if len(_json(result).encode()) > 32768:
+                    result = {"output": "[Oversized result omitted]"}
+            access.event("tool_end", tool=tool, call=call, args=args, result=result, status=values.get("status"))
+
+
+def snapshot(agent, memory_store):
+    access = getattr(agent, "_shared_learning", None)
+    if access is None:
+        return False
+    try:
+        view = access.read("view")
+    except (Unavailable, Refused):
+        view = {}
+    access.read_versions.update(view.get("memory_versions", {}))
+    if memory_store is not None:
+        memory_store.load_shared_snapshot(view.get("memories", {}))
+    return True
+
+
+def catalog(access):
+    value = access.read("view")
+    return [{"name": item["name"], "description": item.get("description", ""),
+             "category": item.get("category", ""), "version": item.get("artifact_version"), "scope": item.get("scope")}
+            for item in value.get("skills", [])]
+
+
+def result_json(receipt):
+    state = receipt.get("state")
+    native = receipt.get("result") or {}
+    return _json({**native, "success": state in {"applied", "pending_review", "rejected", "review_queued"},
+                  "state": state, "queued": state == "queued", "request_id": receipt.get("request_id")})
+
+
+def memory_tool(access, args, call=None):
+    target = args.get("target", "memory")
+    base = access.read_versions.get(target)
+    if base is None:
+        try:
+            base = access.read("view").get("memory_versions", {}).get(target)
+        except Unavailable:
+            # An unavailable base may never silently overwrite a newer value.
+            base = _identifier([])
+    receipt = access.write("memory", args, base, request_id=_write_id(access, call))
+    version = (receipt.get("result") or {}).get("version")
+    if version and receipt["state"] in {"applied", "pending_review"}:
+        access.read_versions[target] = version
+    return result_json(receipt)
+
+
+def _write_id(access, call):
+    return _identifier([access.session, access.turn, call]) if access.turn and call else None
+
+
+def skill_tool(access, args, call=None):
+    args = {name: value for name, value in args.items() if value is not None}
+    operations = args.get("operations")
+    if operations and not args.get("name"):
+        args["name"] = operations[0].get("name")
+    if operations and not args.get("action"):
+        args["action"] = operations[0].get("action")
+    name = args.get("name")
+    if args.get("action") == "create":
+        base = None
+    else:
+        base = access.read_versions.get("skill:" + str(name))
+        if base is None:
+            raise Refused("Read this shared skill with skill_view before modifying it")
+    return result_json(access.write("skills", args, base, request_id=_write_id(access, call)))
+
+
+def skill_view(access, name, file_path=None):
+    request = {"name": name, "file_path": file_path}
+    version_key = "skill:" + name
+    if file_path and access.read_versions.get(version_key):
+        request["artifact_version"] = access.read_versions[version_key]
+    result = access.read("skill", **request)
+    access.read_versions[version_key] = result["version"]
+    linked = {}
+    for path in sorted(result["files"]):
+        if path != "SKILL.md":
+            linked.setdefault(path.partition("/")[0], []).append(path)
+    return {"success": True, **result, "linked_files": linked}
+
+
+def feedback_tool(args, **_):
+    access = active()
+    name = args.get("name", "")
+    if access is None or name not in access.deliveries:
+        return _json({"success": False, "error": "Load this skill in the current session before reporting application"})
+    access.client.flush()
+    try:
+        result = access.read("feedback", delivery_token=access.deliveries[name],
+                             stage=args.get("stage"), tests=args.get("tests", []))
+        return _json({"success": True, **result})
+    except (Unavailable, Refused) as exc:
+        return _json({"success": False, "error": str(exc)})
+
+
+def pending_command(access, subsystem, args):
+    view = access.read("pending", subsystem=subsystem)
+    records = view["records"]
+    command = args[0].lower() if args else "pending"
+    if command == "pending":
+        lines = [f"Shared {subsystem} pending ({view['scope']})"]
+        for record in records:
+            lines.append(f"{record['id']}  {record.get('summary', '')}")
+        return "\n".join(lines) if records else f"No pending shared {subsystem} writes in {view['scope']}."
+    if command == "diff" and len(args) == 2:
+        item = next((item for item in records if item["id"] == args[1]), None)
+        return json.dumps(item["payload"], ensure_ascii=False, indent=2) if item else "Pending write not found in this scope."
+    aliases = {"apply": "approve", "reject": "reject", "approve": "approve", "deny": "reject", "drop": "reject"}
+    decision = aliases.get(command)
+    if decision and len(args) == 2:
+        selected = [item for item in records if args[1] in {"all", item["id"]}]
+        if not selected:
+            return "Pending write not found in this scope."
+        return "\n".join(result_json(access.write("decide", {
+            "subsystem": subsystem, "decision": decision, "id": item["id"], "revision": item["revision"],
+        }, request_id=_identifier([access.cwd, decision, subsystem, item["id"], item["revision"]]))) for item in selected[:20])
+    return "Use pending, diff <id>, approve <id>, or reject <id> in the shared library."
+
+
+def journey_action(access, operation, node, content=None):
+    detail = access.read("journey", id=node)
+    if operation == "detail" or not detail.get("ok"):
+        return detail
+    if node != detail.get("id"):
+        return {"ok": False, "message": "Open Journey and edit the selected shared version"}
+    args = {"id": node}
+    if content is not None:
+        args["content"] = content
+    receipt = access.write("journey_" + operation, args, detail["version"])
+    state = receipt["state"]
+    result = receipt.get("result") or {}
+    return {**result, "ok": state == "applied", "state": state,
+            "message": result.get("message") or result.get("error") or f"Shared request {receipt['request_id']}: {state}"}
+
+
+def reset_memory(access, target):
+    if target not in {"memory", "user"}:
+        raise Refused("Choose project memory or user memory explicitly")
+    version = access.read("view")["memory_versions"].get(target)
+    if version is None:
+        raise Refused("Choose a workspace before clearing project memory")
+    return access.write("clear", {"target": target, "confirmed": True}, version)
