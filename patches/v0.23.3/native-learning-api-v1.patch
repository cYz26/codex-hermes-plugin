+    try:
+        handle = api.open({'host': 'fixture', 'project': str(tmp_path), 'chat': 'chat'})['handle']
+        with api._service.db:
+            api._service.db.execute('UPDATE scopes SET activity=activity-10000 WHERE id=?', (handle,))
+        api.maintenance(host_idle_seconds=3)
+        assert calls == [3]
+        api.maintenance(handle=handle, idle_flush=True)
+        assert calls == [3]
+        for invalid in (-1, True, float('nan'), float('inf')):
