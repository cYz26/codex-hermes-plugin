+"""Context-local storage and visibility for the owner of shared learning."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+
+
+@dataclass
+class Scope:
+    memory: object
+    user: object
+    pending: object
+    project: str | None
+    memory_guard: object = None
+    can_edit_skill: object = None
+    visible_skill: object = None
+    load_skill: object = None
+    memory_visible: object = None
+    memory_commit: object = None
+
+
+current = ContextVar("shared_learning_owner_scope", default=None)
+
+
+@contextmanager
+def use(scope):
+    token = current.set(scope)
+    try:
+        yield
+    finally:
+        current.reset(token)
