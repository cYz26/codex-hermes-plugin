+    @_bound
+    def prune(self, *, retention_seconds: float = 30 * 86400, dry_run: bool = True) -> dict:
+        if not isinstance(dry_run, bool) or not 86400 <= retention_seconds <= 3650 * 86400:
+            raise ValueError("Retention requires a boolean preview and at least one day")
+        with self.lock:
+            rows = self.db.execute(
+                "SELECT s.id,s.revision FROM scopes s WHERE s.activity<? AND s.reviewed>=s.revision "
+                "AND NOT EXISTS (SELECT 1 FROM intents i WHERE i.handle=s.id AND i.status IN ('queued','running','unknown')) "
+                "AND NOT EXISTS (SELECT 1 FROM observations o WHERE o.handle=s.id AND o.projection!='projected') "
+                "AND NOT EXISTS (SELECT 1 FROM retired_scopes r WHERE r.handle=s.id AND r.revision>=s.revision) "
+                "ORDER BY s.activity LIMIT 100", (time.time()-retention_seconds,)).fetchall()
+            result = {"eligible_scopes":len(rows), "eligible_handles":[row["id"] for row in rows],
+                      "retired_scopes":0, "dry_run":dry_run}
+            explicit = self.db.execute("SELECT e.id,i.id intent,i.payload FROM explicit_reviews e JOIN intents i ON i.id=e.intent "
+                "WHERE e.created<? AND e.messages!='[]' AND i.status IN ('completed','failed','interrupted','cancelled') LIMIT 1000",
+                (time.time()-retention_seconds,)).fetchall()
+            result["eligible_explicit_requests"] = len(explicit)
+            if dry_run:
+                return result
+            with self.db:
+                for request in explicit:
+                    self.db.execute("UPDATE explicit_reviews SET messages='[]' WHERE id=?", (request["id"],))
+                    payload = json.loads(request["payload"])
+                    payload.pop("focus", None)
+                    payload["body_retired"] = True
+                    self.db.execute("UPDATE intents SET payload=? WHERE id=?", (json.dumps(payload),request["intent"]))
+                    attempt = self.db.execute("SELECT id,payload FROM attempts WHERE intent=?", (request["intent"],)).fetchone()
+                    if attempt:
+                        outcome = json.loads(attempt["payload"])
+                        summary = {key:outcome[key] for key in ("run_status","usage","id","intent_id") if key in outcome}
+                        summary.update(retired=True, applied_count=len(outcome.get("applied",[])), staged_count=len(outcome.get("staged",[])))
+                        self.db.execute("UPDATE attempts SET payload=? WHERE id=?", (json.dumps(summary),attempt["id"]))
+            for row in rows:
+                # Native projection storage owns its own retirement. Repeated deletion
+                # after interruption is safe; journal tombstones commit afterward.
+                self.runtime.prune_scope(row["id"])
+                with self.db:
+                    for observation in self.db.execute("SELECT id,turn,body FROM observations WHERE handle=?", (row["id"],)).fetchall():
+                        body = json.loads(observation["body"])
+                        if body.get("retired"):
+                            continue
+                        self.db.execute("INSERT OR IGNORE INTO retired_observations VALUES (?,?,?,?)",
+                                        (row["id"],observation["turn"],fingerprint(body),observation["id"]))
+                    self.db.execute("UPDATE observations SET body=?,messages='[]' WHERE handle=?",
+                                    (json.dumps({"retired":True}),row["id"]))
+                    for attempt in self.db.execute("SELECT a.id,a.payload FROM attempts a JOIN intents i ON a.intent=i.id WHERE i.handle=?",
+                                                    (row["id"],)).fetchall():
+                        value = json.loads(attempt["payload"])
+                        summary = {key:value[key] for key in ("run_status","usage","id","intent_id") if key in value}
+                        summary.update(retired=True, applied_count=len(value.get("applied", [])), staged_count=len(value.get("staged", [])))
+                        self.db.execute("UPDATE attempts SET payload=? WHERE id=?", (json.dumps(summary),attempt["id"]))
+                    self.db.execute("INSERT OR REPLACE INTO retired_scopes VALUES (?,?,?)", (row["id"],row["revision"],time.time()))
+                result["retired_scopes"] += 1
+            return result
+
+    @_bound
+    def prune_artifacts(self, protected_versions: list[str], *, retention_seconds: float = 30 * 86400,
+                        dry_run: bool = True) -> dict:
+        from agent.learning_maintenance import prune_artifacts
+        with self.lock:
+            protected = set(protected_versions)
+            protected.update(row[0] for row in self.db.execute('SELECT DISTINCT version FROM deliveries'))
+            return prune_artifacts(self.home, list(protected), retention_seconds=retention_seconds, dry_run=dry_run)
+
+    @_bound
+    def configure_curator(self) -> dict:
+        from agent.learning_maintenance import configure
+        with self.lock:
+            return configure()
+
+    @_bound
+    def record_usage(self, token: str, evidence: dict) -> dict:
+        from tools.skill_usage import bump_use, bump_view
+        with self.lock, self.db:
+            row = self.db.execute("SELECT * FROM deliveries WHERE token=?", (token,)).fetchone()
+            if row is None:
+                raise ValueError("Unknown skill delivery")
+            if row["status"] != "issued":
+                return {"recorded": False, "status": row["status"]}
+            if evidence.get("stage") != "body_delivered" or not evidence.get("source_event"):
+                raise ValueError("Usage requires a confirmed body delivery source")
+            self.db.execute("UPDATE deliveries SET status='applying',evidence=? WHERE token=?", (json.dumps(evidence), token))
+        bump_view(row["name"])
+        bump_use(row["name"], task_id=str(evidence["source_event"]))
+        with self.lock, self.db:
+            self.db.execute("UPDATE deliveries SET status='recorded' WHERE token=?", (token,))
+        return {"recorded": True, "native_telemetry": "best_effort"}
+
+    @_bound
+    def maintenance(self, *, handle: str | None = None, idle_flush: bool = False,
+                    host_idle_seconds: float | None = None) -> dict:
+        import math
+        if host_idle_seconds is not None and (isinstance(host_idle_seconds, bool)
+                or not isinstance(host_idle_seconds, (int, float)) or not math.isfinite(host_idle_seconds)
+                or host_idle_seconds < 0):
+            raise ValueError('Host idle time must be a finite non-negative duration')
+        with self.lock, self.db:
+            for row in self.db.execute("SELECT id FROM observations WHERE projection='pending'").fetchall():
+                self._project(row[0])
+            intent = None
+            if idle_flush:
+                scope = self._scope(handle)
+                pending = self.db.execute("SELECT 1 FROM intents WHERE handle=? AND status IN ('queued','running','unknown')", (handle,)).fetchone()
+                attempted = self.db.execute("SELECT 1 FROM intents WHERE handle=? AND revision>=? AND status IN ('completed','failed','interrupted')",
+                                            (handle, scope["revision"])).fetchone()
+                if scope["revision"] > scope["reviewed"] and not pending and not attempted:
+                    intent = self._intent(handle, scope["revision"], True, True, "idle_flush")
+            last = self.db.execute("SELECT MAX(activity) FROM scopes").fetchone()[0]
+        if idle_flush:
+            # A turn flush may occur while another host chat is active. Only
+            # the host's separate idle-maintenance call owns Curator scheduling.
+            return {"intent": intent, "curator": None}
+        idle = max(0, time.time() - (last or time.time()))
+        if host_idle_seconds is not None:
+            idle = min(idle, host_idle_seconds)
+        return {"intent": intent, **self.runtime.maintenance(idle)}
+
+    @_bound
+    def cancel(self) -> dict:
+        self.runtime.cancel()
+        return {"requested": True, "rollback": False}
+
+    @_bound
+    def close(self, *, handle: str | None = None, event_id: str | None = None) -> dict:
+        if handle is not None:
+            return self._close_scope(handle, event_id)
+        if self.closed:
+            return {"closed": True}
+        result = self.runtime.close()
+        self.db.close()
+        self.owner.close()
+        self.closed = True
+        return result
+
+    def _close_scope(self, handle, event_id):
+        if not event_id:
+            raise ValueError("A real session-end event id is required")
+        with self.lock, self.db:
+            previous = self.db.execute("SELECT status,payload FROM closures WHERE id=?", (event_id,)).fetchone()
+            if previous:
+                return {"status": previous["status"], **json.loads(previous["payload"])}
+            if self.db.execute("SELECT 1 FROM intents WHERE handle=? AND status IN ('queued','running')", (handle,)).fetchone():
+                return {"status": "deferred"}
+            self.db.execute("INSERT INTO closures VALUES (?,?,'closing','{}')", (event_id, handle))
+        result = self.runtime.close_scope(handle)
+        with self.lock, self.db:
+            self.db.execute("UPDATE closures SET status='closed',payload=? WHERE id=?", (json.dumps(result), event_id))
+        return {"status": "closed", **result}
