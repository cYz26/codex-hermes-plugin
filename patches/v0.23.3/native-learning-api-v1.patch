+import json
+import time
+import pytest
+
+
+class Runtime:
+    def __init__(self):
+        self.projects, self.retired = [], []
+    def tick(self, handle, source, memory_count, skill_count, **kwargs):
+        return dict(memory=False,skills=False,memory_count=memory_count,skill_count=skill_count)
+    def project(self, handle, source, messages, **kwargs):
+        self.projects.extend(messages)
+        return "not_configured"
+    def review(self, *args):
+        return dict(run_status="completed",applied=[],staged=[],uncertain=[])
+    def maintenance(self, *args):
+        return {}
+    def usage(self, *args):
+        return None
+    def close(self):
+        return {}
+    def prune_scope(self, handle):
+        self.retired.append(handle)
+
+
+@pytest.fixture
+def service(tmp_path, monkeypatch):
