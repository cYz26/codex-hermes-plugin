+            "user":"Verify the failure","assistant":"Observed failure","status":"completed",
+            "tools":[{"call_id":"failed-call","name":"terminal","arguments":{},"result":"synthetic failure","status":"failed"}]}
+
+
+def test_failed_terminal_execution_is_in_review_evidence(service):
+    body = observation()
+    handle = service.open({k:v for k,v in body["source"].items() if k != "turn"})["handle"]
+    service.observe(handle,body,event_id="first")
+    assert any(m.get("role") == "tool" and "synthetic failure" in m["content"] for m in service.runtime.projects)
