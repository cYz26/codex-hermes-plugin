+
+def test_retention_preserves_identity_and_does_not_replay_processed_body(service):
+    body = observation()
+    handle = service.open({k:v for k,v in body["source"].items() if k != "turn"})["handle"]
+    service.observe(handle,body,event_id="first")
+    intent = service.maintenance(handle=handle,idle_flush=True)["intent"]
+    service.run_review(handle,intent,attempt_id="review")
